@model BookingConfirmationViewModel
@{
    ViewData["Title"] = "Booking Received";
}

<section class="confirmation">
    <div class="confirmation-card">
        <div class="success-icon">✓</div>
        <span class="eyebrow dark">BOOKING REQUEST RECEIVED</span>
        <h1>You're all set, @Model.Booking.GuestName.</h1>
        <p>We've received your booking request. Keep your reference number for future communication.</p>

        <div class="reference">@Model.Booking.BookingReference</div>

        <div class="summary">
            <div><span>Room</span><strong>@Model.Booking.Room?.Name</strong></div>
            <div><span>Check-in</span><strong>@Model.Booking.CheckIn.ToString("dd MMM yyyy")</strong></div>
            <div><span>Check-out</span><strong>@Model.Booking.CheckOut.ToString("dd MMM yyyy")</strong></div>
            <div><span>Guests</span><strong>@Model.Booking.Guests</strong></div>
            <div><span>Estimated total</span><strong>₹@Model.Booking.TotalAmount.ToString("N0")</strong></div>
            <div><span>Status</span><strong class="status">@Model.Booking.Status</strong></div>
        </div>

        <div class="confirmation-actions">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to resort</a>
            <a class="btn btn-outline" href="https://wa.me/@Model.Resort.WhatsAppNumber?text=Hello%2C%20my%20booking%20reference%20is%20@Model.Booking.BookingReference" target="_blank">Continue on WhatsApp</a>
        </div>
    </div>
</section>
