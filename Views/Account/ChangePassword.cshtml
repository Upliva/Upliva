@model UplivaAI.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container admin-narrow"><div class="admin-head"><div><span class="platform-kicker dark">ACCOUNT SECURITY</span><h1>Change password</h1><p>Use a new password that is at least 8 characters long.</p></div></div><form method="post" class="business-form">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" type="password" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="validation"></span></div><div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" type="password" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="validation"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation"></span></div><div class="ws-form-actions"><button class="platform-btn platform-btn-primary">Change password</button><a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessDashboard" asp-action="Index">Cancel</a></div></form></div></section>
