@model UplivaAI.Models.PublicCatalogViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Business.Name;
    var publicUrl = Url.Action("Catalog", "PublicBusiness", new { slug = Model.Business.Slug }, Context.Request.Scheme)
        ?? $"/business/{Model.Business.Slug}";
    var uplivaHomeUrl = Url.Action("Index", "Home") ?? "/";
    var businessLogo = !string.IsNullOrWhiteSpace(Model.Business.LogoUrl)
        ? Model.Business.LogoUrl
        : (!string.IsNullOrWhiteSpace(Model.Business.LogoBlobName) ? $"/media/{Model.Business.LogoBlobName}" : "");
    var businessInitial = string.IsNullOrWhiteSpace(Model.Business.Name) ? "B" : Model.Business.Name.Trim()[0].ToString().ToUpperInvariant();
    var phone = new string((Model.Business.PhoneNumber ?? Model.Business.WhatsAppNumber ?? string.Empty).Where(char.IsDigit).ToArray());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="@Model.Business.Name - products, services and customer enquiries." />
    <title>@Model.Business.Name · UplivaAI</title>
    <link rel="stylesheet" href="~/css/business-site.css" asp-append-version="true" />
</head>
<body class="upliva-business-body">
    <div class="business-shell">
        <!-- Upliva platform header -->
        <header class="upliva-platform-header">
            <div class="platform-header-inner">
                <a class="upliva-platform-brand" href="@uplivaHomeUrl" aria-label="UplivaAI home">
                    <img src="~/images/upliva/upliva-logo.svg" alt="UplivaAI" />
                </a>
                <span class="platform-caption">WhatsApp-first business platform</span>
            </div>
        </header>

        <!-- Business / WhatsApp header -->
        <header class="whatsapp-business-header">
            <div class="whatsapp-header-inner">
                <a class="business-back" href="@publicUrl" aria-label="Back to @Model.Business.Name">‹</a>

                @if (!string.IsNullOrWhiteSpace(businessLogo))
                {
                    <img class="business-avatar" src="@businessLogo" alt="@Model.Business.Name" />
                }
                else
                {
                    <div class="business-avatar business-avatar-fallback" aria-hidden="true">@businessInitial</div>
                }

                <a class="business-header-identity" href="@publicUrl">
                    <strong>@Model.Business.Name</strong>
                    <span><i></i> Online · @Model.Business.BusinessType</span>
                </a>

                <div class="business-header-actions">
                    @if (!string.IsNullOrWhiteSpace(phone))
                    {
                        <a href="tel:+@phone" class="header-icon-button" aria-label="Call @Model.Business.Name">☎</a>
                    }
                    <a href="#business-footer" class="header-icon-button" aria-label="Business information">⋮</a>
                </div>
            </div>
        </header>

        <main class="whatsapp-page">
            @if (!string.IsNullOrWhiteSpace(Model.Business.BannerBlobName))
            {
                <div class="business-banner-wrap">
                    <img class="business-banner" src="/media/@Model.Business.BannerBlobName" alt="@Model.Business.Name banner" />
                </div>
            }

            <section class="welcome-message" aria-label="Business welcome message">
                <div class="welcome-title">👋 Welcome to @Model.Business.Name!</div>
                <div class="welcome-text">@(string.IsNullOrWhiteSpace(Model.Business.Description) ? $"Browse our products, view prices, ask a question, or call us directly." : Model.Business.Description)</div>
                <time>Now</time>
            </section>

            @if (TempData["PublicEnquirySuccess"] is string success)
            {
                <div class="success-message" role="status">✓ @success</div>
            }

            <nav class="category-scroller" aria-label="Product categories">
                <a class="category-chip @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : "")" href="@publicUrl">All Products</a>
                @foreach (var category in Model.Categories)
                {
                    <a class="category-chip @(string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       href="@publicUrl?category=@Uri.EscapeDataString(category)">@category</a>
                }
            </nav>

            <form class="product-search" method="get" action="@publicUrl">
                <span class="search-icon" aria-hidden="true">⌕</span>
                <input name="search" value="@Model.Search" placeholder="Search products (e.g. sofa, recliner, chair)" autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <input type="hidden" name="category" value="@Model.Category" />
                }
                <button type="submit" aria-label="Search products">➜</button>
            </form>

            @if (Model.Offers.Count > 0)
            {
                <section class="offers-section">
                    <div class="section-heading">
                        <div>
                            <span class="section-kicker">SPECIAL</span>
                            <h2>Offers & deals</h2>
                        </div>
                    </div>
                    <div class="offers-row">
                        @foreach (var offer in Model.Offers)
                        {
                            <article class="offer-card">
                                @if (!string.IsNullOrWhiteSpace(offer.ImageUrl))
                                {
                                    <img src="@offer.ImageUrl" loading="lazy" alt="@offer.Title" />
                                }
                                <div>
                                    <strong>@offer.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(offer.Description))
                                    {
                                        <p>@offer.Description</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(offer.DiscountText))
                                    {
                                        <b>@offer.DiscountText</b>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="catalog-section" aria-label="Products">
                <div class="section-heading">
                    <div>
                        <span class="section-kicker">CATALOG</span>
                        <h2>Featured Products</h2>
                        <p>Browse, compare and ask about anything you like.</p>
                    </div>
                    <span class="item-count">@Model.Products.Count items</span>
                </div>

                @if (!Model.Products.Any())
                {
                    <div class="empty-state">No products or services found. Try another search.</div>
                }
                else
                {
                    <div class="product-list">
                        @foreach (var item in Model.Products)
                        {
                            <article class="product-card" tabindex="0" role="button" aria-label="View @item.Name"
                                     data-id="@item.Id"
                                     data-name="@item.Name"
                                     data-price="@item.PriceText"
                                     data-category="@item.Category"
                                     data-description="@(string.IsNullOrWhiteSpace(item.Description) ? item.ShortDescription : item.Description)"
                                     data-image="@item.ImageUrl"
                                     data-stock="@item.StockStatus"
                                     onclick="openProductFromCard(this)"
                                     onkeydown="if(event.key === 'Enter' || event.key === ' '){event.preventDefault();openProductFromCard(this);}">
                                <div class="product-image-wrap">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img class="product-image" src="@item.ImageUrl" loading="lazy" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">No image</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Category))
                                    {
                                        <span class="product-badge">@item.Category</span>
                                    }
                                    <button class="heart-button" type="button" aria-label="View @item.Name" onclick="event.stopPropagation(); openProductFromCard(this.closest('.product-card'));">♡</button>
                                </div>
                                <div class="product-content">
                                    <div class="product-title-row">
                                        <h3>@item.Name</h3>
                                        <span class="product-arrow">›</span>
                                    </div>
                                    <div class="product-price">@item.PriceText</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                                    {
                                        <p>@item.ShortDescription</p>
                                    }
                                    <div class="product-actions">
                                        <button class="outline-button" type="button" onclick="event.stopPropagation(); openProductFromCard(this.closest('.product-card'));">View Details</button>
                                        <button class="whatsapp-button" type="button" onclick="event.stopPropagation(); openEnquiryFromCard(this.closest('.product-card'));">Ask About</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <!-- WhatsApp-style message composer -->
            <section class="message-composer" aria-label="Message business">
                <a class="composer-call" href="@(string.IsNullOrWhiteSpace(phone) ? "#business-footer" : $"tel:+{phone}")" aria-label="Call business">☎</a>
                <button class="composer-input" type="button" onclick="openGeneralEnquiry()">
                    <span>💬</span> Type a message or ask about a product...
                </button>
                <button class="composer-send" type="button" onclick="openGeneralEnquiry()" aria-label="Send enquiry">➤</button>
            </section>
        </main>

        <!-- Upliva footer -->
        <footer id="business-footer" class="upliva-business-footer">
            <div class="footer-brand-block">
                <a href="@uplivaHomeUrl" class="footer-logo-link" aria-label="UplivaAI home">
                    <img src="~/images/upliva/upliva-logo.svg" alt="UplivaAI" />
                </a>
                <p>WhatsApp-first business platform for local businesses.</p>
            </div>
            <div class="footer-business-block">
                <strong>@Model.Business.Name</strong>
                <span>@Model.Business.BusinessType</span>
                @if (!string.IsNullOrWhiteSpace(Model.Business.City))
                {
                    <span>@Model.Business.City@(string.IsNullOrWhiteSpace(Model.Business.State) ? "" : ", " + Model.Business.State)</span>
                }
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.UtcNow.Year UplivaAI</span>
                <span>Powered by UplivaAI</span>
            </div>
        </footer>
    </div>

    <!-- Product details modal -->
    <div id="productModal" class="modal-backdrop" hidden onclick="closeProduct(event)">
        <section class="product-modal" role="dialog" aria-modal="true" aria-labelledby="modalProductName" onclick="event.stopPropagation()">
            <button class="modal-close" type="button" onclick="closeProduct()" aria-label="Close">×</button>
            <img id="modalProductImage" class="modal-product-image" alt="" hidden />
            <div class="modal-product-body">
                <span id="modalProductCategory" class="modal-category"></span>
                <h2 id="modalProductName"></h2>
                <div id="modalProductPrice" class="modal-price"></div>
                <p id="modalProductDescription"></p>
                <div id="modalProductStock" class="modal-stock"></div>
                <button id="modalAskButton" class="whatsapp-button modal-ask" type="button">💬 Ask About This Product</button>
            </div>
        </section>
    </div>

    <!-- Enquiry modal -->
    <div id="enquiryModal" class="modal-backdrop" hidden onclick="closeEnquiry(event)">
        <section class="enquiry-modal" role="dialog" aria-modal="true" aria-labelledby="enquiryTitle" onclick="event.stopPropagation()">
            <button class="modal-close" type="button" onclick="closeEnquiry()" aria-label="Close">×</button>
            <div class="enquiry-heading">
                <span>💬</span>
                <div><h2 id="enquiryTitle">Send Enquiry</h2><p id="enquiryProduct">Tell the business what you need.</p></div>
            </div>
            <form method="post" action="/business/@Model.Business.Slug/enquiry" class="enquiry-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CatalogItemId" id="catalogItemId" />
                <input type="text" name="Website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
                <label>Your Name<input name="Name" required maxlength="150" placeholder="Enter your name" /></label>
                <label>Your Phone Number<input name="PhoneNumber" required maxlength="30" inputmode="tel" placeholder="Enter your phone number" /></label>
                <label>Email <span>(optional)</span><input name="Email" type="email" maxlength="200" placeholder="Enter your email" /></label>
                <label>Your Message<textarea name="Message" required maxlength="2000" rows="4">Hi, I am interested in this product. Please share more details.</textarea></label>
                <button class="whatsapp-button enquiry-submit" type="submit">💬 Send Enquiry</button>
            </form>
        </section>
    </div>

    <script>
        const productModal = document.getElementById('productModal');
        const enquiryModal = document.getElementById('enquiryModal');
        const catalogItemId = document.getElementById('catalogItemId');
        const enquiryProduct = document.getElementById('enquiryProduct');

        function productFromCard(card) {
            return {
                id: card.dataset.id,
                name: card.dataset.name || '',
                price: card.dataset.price || '',
                category: card.dataset.category || '',
                description: card.dataset.description || '',
                image: card.dataset.image || '',
                stock: card.dataset.stock || ''
            };
        }

        function openProductFromCard(card) {
            if (card) openProduct(productFromCard(card));
        }

        function openEnquiryFromCard(card) {
            if (!card) return;
            const product = productFromCard(card);
            openEnquiry(product.id, product.name);
        }

        function openProduct(product) {
            document.getElementById('modalProductName').textContent = product.name || '';
            document.getElementById('modalProductPrice').textContent = product.price || '';
            document.getElementById('modalProductCategory').textContent = product.category || 'Product';
            document.getElementById('modalProductDescription').textContent = product.description || 'Please contact the business for more details.';
            const stock = document.getElementById('modalProductStock');
            stock.textContent = product.stock || '';
            stock.hidden = !product.stock;

            const image = document.getElementById('modalProductImage');
            if (product.image) {
                image.src = product.image;
                image.alt = product.name || '';
                image.hidden = false;
            } else {
                image.hidden = true;
            }

            document.getElementById('modalAskButton').onclick = function () {
                closeProduct();
                openEnquiry(product.id, product.name);
            };
            productModal.hidden = false;
            document.body.classList.add('modal-open');
        }

        function closeProduct(event) {
            if (event && event.target !== productModal) return;
            productModal.hidden = true;
            if (enquiryModal.hidden) document.body.classList.remove('modal-open');
        }

        function openEnquiry(id, name) {
            catalogItemId.value = id || '';
            enquiryProduct.textContent = id ? 'Enquiry for: ' + name : 'Tell the business what you need.';
            enquiryModal.hidden = false;
            document.body.classList.add('modal-open');
        }

        function openGeneralEnquiry() {
            openEnquiry('', '');
        }

        function closeEnquiry(event) {
            if (event && event.target !== enquiryModal) return;
            enquiryModal.hidden = true;
            if (productModal.hidden) document.body.classList.remove('modal-open');
        }

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                productModal.hidden = true;
                enquiryModal.hidden = true;
                document.body.classList.remove('modal-open');
            }
        });
    </script>
</body>
</html>
