@model UplivaAI.Models.BusinessProvisioningResult
@{ ViewData["Title"] = "Business account created"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container admin-narrow"><div class="admin-head"><div><span class="platform-kicker dark">ACCOUNT CREATED</span><h1>@Model.Business.Name is ready</h1><p>The business has been approved and the Business Owner login has been created.</p></div></div><div class="admin-note-card"><strong>Give these credentials to the business owner</strong><span><b>User ID:</b> @Model.UserId<br/><b>Temporary password:</b> @Model.TemporaryPassword</span></div><div class="admin-note-card"><strong>Important</strong><span>This password is shown only here. The database stores only the password hash. Ask the owner to change it after the first login.</span></div><div class="ws-form-actions"><a class="workspace-btn workspace-btn-primary" asp-controller="AdminDashboard" asp-action="Index">Back to dashboard</a><a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessDashboard" asp-action="Index">Open business dashboard</a></div></div></section>
