@model List<WhatsAppMessageLog>
@{
    var business = (Business)ViewBag.Business;
    var search = (string)(ViewBag.Search ?? string.Empty);
    ViewData["Title"] = "WhatsApp Messages";
    Layout = "_AdminLayout";
}
<section class="admin-page">
    <div class="container" style="max-width:1500px">
        <div class="admin-head">
            <div><span class="platform-kicker dark">WHATSAPP MESSAGES</span><h1>@business.Name</h1><p>Inbound customer messages and outbound UplivaAI responses.</p></div>
            <div class="workspace-page-actions"><a class="workspace-btn workspace-btn-secondary" asp-controller="AdminBusinessIntegration" asp-action="Manage" asp-route-id="@business.Id">← WhatsApp Business</a></div>
        </div>
        <form method="get" class="lead-search-bar" style="margin-bottom:18px">
            <input type="hidden" name="businessId" value="@business.Id" />
            <div class="lead-search-field"><label for="q">Search messages</label><input id="q" name="q" value="@search" placeholder="Phone, customer name or message" /></div>
            <button class="workspace-btn workspace-btn-secondary" type="submit">Search</button>
        </form>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Time</th><th>Direction</th><th>Customer</th><th>Type</th><th>Message</th><th>Status</th></tr></thead>
                <tbody>
                @if(Model.Count == 0){<tr><td colspan="6">No WhatsApp messages have been logged yet.</td></tr>}
                @foreach(var message in Model){
                    <tr>
                        <td>@message.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td><strong>@message.Direction</strong></td>
                        <td>@(string.IsNullOrWhiteSpace(message.CustomerName) ? "Customer" : message.CustomerName)<small style="display:block;color:#7a8790">@message.CustomerPhoneNumber</small></td>
                        <td>@message.MessageType</td>
                        <td style="max-width:520px;white-space:pre-wrap">@message.MessageText</td>
                        <td>@message.DeliveryStatus</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
