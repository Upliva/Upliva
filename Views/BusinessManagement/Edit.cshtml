@model BusinessEditViewModel
@{
    ViewData["Title"] = "Edit Business";
    Layout = "_AdminLayout";
}
<section class="admin-page">
    <div class="container" style="max-width:1180px">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">BUSINESS MANAGEMENT</span>
                <h1>Edit @Model.Name</h1>
                <p>All business profile fields are optional. Leave anything blank and complete it later; WhatsApp is checked for duplicate numbers when supplied.</p>
            </div>
            <div class="workspace-page-actions">
                <a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessContent" asp-action="Index" asp-route-id="@Model.Id">Catalog</a>
                <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminBusinessIntegration" asp-action="Manage" asp-route-id="@Model.Id">WhatsApp Business</a>
                <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminMarketing" asp-action="Index">Back to Leads</a>
            </div>
        </div>

        <div class="admin-note-card" style="margin-bottom:18px">
            <strong>System information</strong>
            <span>Status: <b>@Model.Status</b> · Slug: <b>@Model.Slug</b> · Catalog template: <b>@Model.CatalogTemplateKey</b> · Created: @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="business-form" style="max-width:none">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="form-grid">
                    <div class="field full">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" />
                        <span asp-validation-for="Name" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="BusinessType"></label>
                        <select asp-for="BusinessType">
                            @foreach (var type in BusinessTypeOptions.All)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="BusinessType" class="validation"></span>
                        <span class="field-hint">Changing the business type also updates the catalog template key.</span>
                    </div>

                    <div class="field">
                        <label asp-for="ServicePlan"></label>
                        <select asp-for="ServicePlan">
                            <option value="">Plan not selected</option>
                            @foreach (var plan in BusinessServicePlans.All)
                            {
                                <option value="@plan">@BusinessServicePlans.GetDisplayName(plan)</option>
                            }
                        </select>
                        <span asp-validation-for="ServicePlan" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="OwnerName"></label>
                        <input asp-for="OwnerName" />
                        <span asp-validation-for="OwnerName" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" />
                        <span asp-validation-for="Email" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="PhoneNumber"></label>
                        <input asp-for="PhoneNumber" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="WhatsAppNumber"></label>
                        <input asp-for="WhatsAppNumber" autocomplete="tel" />
                        <span asp-validation-for="WhatsAppNumber" class="validation"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="Address"></label>
                        <input asp-for="Address" />
                        <span asp-validation-for="Address" class="validation"></span>
                    </div>

                    <div class="field"><label asp-for="City"></label><input asp-for="City" /><span asp-validation-for="City" class="validation"></span></div>
                    <div class="field"><label asp-for="State"></label><input asp-for="State" /><span asp-validation-for="State" class="validation"></span></div>
                    <div class="field"><label asp-for="PostalCode"></label><input asp-for="PostalCode" /><span asp-validation-for="PostalCode" class="validation"></span></div>
                    <div class="field"><label asp-for="Country"></label><input asp-for="Country" /><span asp-validation-for="Country" class="validation"></span></div>

                    <div class="field full">
                        <label asp-for="BusinessHours"></label>
                        <input asp-for="BusinessHours" placeholder="e.g. Mon-Sat 10 AM - 8 PM" />
                        <span asp-validation-for="BusinessHours" class="validation"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="Tagline"></label>
                        <input asp-for="Tagline" />
                        <span asp-validation-for="Tagline" class="validation"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="6"></textarea>
                        <span asp-validation-for="Description" class="validation"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="LogoUrl"></label>
                        <input asp-for="LogoUrl" placeholder="https://..." />
                        <span asp-validation-for="LogoUrl" class="validation"></span>
                    </div>
                </div>

                <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:18px">
                    <button class="platform-btn platform-btn-primary" type="submit" id="saveBusinessButton">Save business changes</button>
                    <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminMarketing" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
<script>
(() => {
    const form = document.querySelector('form[asp-action="Edit"]');
    const button = document.getElementById('saveBusinessButton');
    form?.addEventListener('submit', () => {
        if (button) { button.disabled = true; button.textContent = 'Saving…'; }
    });
})();
</script>
}
