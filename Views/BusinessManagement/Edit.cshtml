@model BusinessEditViewModel
@{ ViewData["Title"] = "Edit Business"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container admin-narrow"><div class="admin-head"><div><span class="platform-kicker dark">BUSINESS CONFIGURATION</span><h1>Edit business</h1><p>Business information can be updated here. Publishing remains an admin-only action.</p></div></div><div class="business-form"><form method="post"><input type="hidden" asp-for="BusinessId" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field full"><label asp-for="Name"></label><input asp-for="Name" /></div><div class="field"><label asp-for="BusinessType"></label><input asp-for="BusinessType" /></div><div class="field"><label asp-for="OwnerName"></label><input asp-for="OwnerName" /></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" /></div><div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" /></div><div class="field"><label asp-for="WhatsAppNumber"></label><input asp-for="WhatsAppNumber" /></div><div class="field"><label asp-for="City"></label><input asp-for="City" /></div><div class="field"><label asp-for="Address"></label><input asp-for="Address" /></div><div class="field full"><label asp-for="Tagline"></label><input asp-for="Tagline" /></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="field full"><label asp-for="LogoUrl"></label><input asp-for="LogoUrl" /></div><div class="field full"><label asp-for="HeroImageUrl"></label><input asp-for="HeroImageUrl" /></div></div><button class="platform-btn platform-btn-primary" type="submit">Save changes →</button></form></div></div></section>
