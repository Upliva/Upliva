@model WebsiteContentViewModel
@{
    var business = (Business)ViewBag.Business;
    ViewData["Title"] = "Website Content";
    Layout = "_AdminLayout";
}

<section class="admin-page">
    <div class="container admin-narrow">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">WEBSITE CONTENT</span>
                <h1>@business.Name</h1>
                <p>Manage the text that appears on the generated public website. Catalog products are managed separately.</p>
            </div>
            <div class="workspace-page-actions">
                @if (User.IsInRole(PlatformRoles.Admin)) { <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminDashboard" asp-action="Index">← Back to admin</a> } else { <a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessDashboard" asp-action="Index">← Back to dashboard</a> }
                <a class="workspace-btn workspace-btn-primary" asp-controller="Business" asp-action="Website" asp-route-slug="@business.Slug">Preview website →</a>
            </div>
        </div>

        <div class="business-form">
            <form asp-controller="BusinessManagement" asp-action="WebsiteContent" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BusinessId" />
                <div asp-validation-summary="ModelOnly" class="validation"></div>

                <h2>Website identity</h2>
                <p style="color:#687284;font-size:13px">The website is hosted inside the UplivaAI application. Customers see the business name and content, while UplivaAI remains the platform provider in the footer.</p>
                <div class="form-grid">
                    <div class="field full"><label asp-for="WebsiteTitle"></label><input asp-for="WebsiteTitle" /><span asp-validation-for="WebsiteTitle" class="validation"></span></div>
                    <div class="field full"><label asp-for="MetaDescription"></label><textarea asp-for="MetaDescription" rows="3" placeholder="Short description for search engines and link previews."></textarea><span asp-validation-for="MetaDescription" class="validation"></span></div>
                </div>

                <h2 style="margin-top:30px">Hero section</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="HeroTitle"></label><input asp-for="HeroTitle" /><span asp-validation-for="HeroTitle" class="validation"></span></div>
                    <div class="field full"><label asp-for="HeroSubtitle"></label><textarea asp-for="HeroSubtitle" rows="3"></textarea></div>
                </div>

                <h2 style="margin-top:30px">About</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="AboutTitle"></label><input asp-for="AboutTitle" /></div>
                    <div class="field full"><label asp-for="AboutContent"></label><textarea asp-for="AboutContent" rows="6" placeholder="Tell customers about the business, experience, products, service area and what you offer."></textarea></div>
                </div>

                <h2 style="margin-top:30px">Why choose us</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="WhyChooseUsTitle"></label><input asp-for="WhyChooseUsTitle" /></div>
                    <div class="field full"><label asp-for="WhyChooseUsContent"></label><textarea asp-for="WhyChooseUsContent" rows="6" placeholder="Use separate lines for key reasons, for example:
Genuine products
Helpful local support
Warranty assistance
Competitive pricing"></textarea></div>
                    <div class="field full" style="display:flex;align-items:center;gap:10px"><input asp-for="ShowWhyChooseUs" style="width:auto" /><label asp-for="ShowWhyChooseUs" style="margin:0">Show this section</label></div>
                </div>

                <h2 style="margin-top:30px">Products &amp; services</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="ServicesTitle"></label><input asp-for="ServicesTitle" /></div>
                    <div class="field full"><label asp-for="ServicesContent"></label><textarea asp-for="ServicesContent" rows="6" placeholder="List services or useful customer information. One item per line works well."></textarea></div>
                    <div class="field full" style="display:flex;align-items:center;gap:10px"><input asp-for="ShowServices" style="width:auto" /><label asp-for="ShowServices" style="margin:0">Show this section</label></div>
                </div>

                <h2 style="margin-top:30px">Call to action</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="CallToActionTitle"></label><input asp-for="CallToActionTitle" /></div>
                    <div class="field full"><label asp-for="CallToActionText"></label><textarea asp-for="CallToActionText" rows="4"></textarea></div>
                    <div class="field full" style="display:flex;align-items:center;gap:10px"><input asp-for="ShowCallToAction" style="width:auto" /><label asp-for="ShowCallToAction" style="margin:0">Show this section</label></div>
                </div>

                <h2 style="margin-top:30px">Website sections</h2>
                <p style="color:#687284;font-size:13px">For the initial MVP, sections are editable and can be shown/hidden without changing the database. Product order is controlled from the catalog. A full drag-and-drop page builder is intentionally not included yet.</p>
                <div class="form-grid">
                    <div class="field full" style="display:flex;gap:18px;flex-wrap:wrap">
                        <label style="display:flex;align-items:center;gap:8px;margin:0"><input asp-for="ShowCatalog" style="width:auto" /> Show catalog</label>
                        <label style="display:flex;align-items:center;gap:8px;margin:0"><input asp-for="ShowOffers" style="width:auto" /> Show offers</label>
                        <label style="display:flex;align-items:center;gap:8px;margin:0"><input asp-for="ShowTestimonials" style="width:auto" /> Show testimonials</label>
                        <label style="display:flex;align-items:center;gap:8px;margin:0"><input asp-for="ShowWhatsApp" style="width:auto" /> Show WhatsApp</label>
                    </div>
                </div>

                <h2 style="margin-top:30px">Brochures / PDF catalog</h2>
                <p style="color:#687284;font-size:13px">Some businesses already have a PDF catalog, property brochure, rate card or room package. Upload the PDF here and it will appear as a downloadable/viewable section on the generated UplivaAI website.</p>
                <div style="background:#f7faf8;border:1px solid #e1ece5;border-radius:12px;padding:16px">
                    <form asp-controller="BusinessManagement" asp-action="UploadBrochure" method="post" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="businessId" value="@business.Id" />
                        <div class="field" style="min-width:280px;flex:1"><label for="brochure">PDF brochure</label><input id="brochure" name="brochure" type="file" accept="application/pdf,.pdf" required /></div>
                        <button class="platform-btn platform-btn-primary" type="submit">Upload PDF</button>
                    </form>
                    <div style="font-size:11px;color:#687284;margin-top:8px">PDF only · maximum 20 MB · files are stored under this business's own folder.</div>
                    @{
                        var brochures = ViewBag.Brochures as IReadOnlyList<UplivaAI.Services.BusinessBrochure> ?? [];
                    }
                    @if (brochures.Count > 0)
                    {
                        <div style="margin-top:16px;display:grid;gap:8px">
                            @foreach (var brochure in brochures)
                            {
                                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px;background:white;border:1px solid #e7ece9;border-radius:10px">
                                    <div><strong>@brochure.DisplayName</strong><div style="font-size:11px;color:#89919e">@(Math.Ceiling(brochure.Length / 1024d / 1024d).ToString("0.0")) MB</div></div>
                                    <div style="display:flex;gap:6px">
                                        <a class="workspace-btn workspace-btn-secondary" href="@brochure.RelativeUrl" target="_blank" rel="noopener">View PDF</a>
                                        <form asp-controller="BusinessManagement" asp-action="DeleteBrochure" method="post" onsubmit="return confirm('Remove this brochure?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="businessId" value="@business.Id" />
                                            <input type="hidden" name="fileName" value="@brochure.FileName" />
                                            <button type="submit">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <h2 style="margin-top:30px">Contact &amp; footer</h2>
                <div class="form-grid">
                    <div class="field full"><label asp-for="ContactIntro"></label><textarea asp-for="ContactIntro" rows="3"></textarea></div>
                    <div class="field full"><label asp-for="FooterText"></label><input asp-for="FooterText" /></div>
                </div>

                <div style="background:#f7faf8;border:1px solid #e1ece5;border-radius:12px;padding:14px;margin:20px 0;color:#536074;font-size:12px">
                    <strong>Important:</strong> Catalog products belong to the product/catalog section. Business storytelling belongs here. This separation lets the same website structure work for mobile shops, furniture stores, salons, restaurants, schools and other businesses.
                </div>

                <button id="saveWebsiteContentButton" class="platform-btn platform-btn-primary" type="submit">Save website content →</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const form = document.querySelector('form[asp-action="WebsiteContent"]');
    const button = document.getElementById('saveWebsiteContentButton');
    if (!form || !button) return;
    form.addEventListener('submit', () => {
        button.disabled = true;
        button.textContent = 'Saving…';
    });
})();
</script>
}
