<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UplivaAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/upliva-theme.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/upliva/upliva-logo.svg" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) => controller == currentController ? "workspace-top-link is-active" : "workspace-top-link";
}
<body class="admin-body">
    <header class="admin-header">
        <div class="container admin-nav">
            <a class="upliva-brand" asp-controller="Home" asp-action="Index" aria-label="UplivaAI home"><img src="~/images/upliva/upliva-logo.svg" alt="UplivaAI" /></a>
            <div class="workspace-top-actions" aria-label="Workspace navigation">
                @if (User.IsInRole(PlatformRoles.Admin))
                {
                    <a class="@NavClass("AdminDashboard")" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                    <a class="@NavClass("AdminMarketing")" asp-controller="AdminMarketing" asp-action="Index">Leads & visits</a>
                    <a class="@NavClass("AdminErrorLogs")" asp-controller="AdminErrorLogs" asp-action="Index">Error logs</a>
                }
                else if (User.IsInRole(PlatformRoles.BusinessOwner))
                {
                    <a class="@NavClass("BusinessDashboard")" asp-controller="BusinessDashboard" asp-action="Index">Dashboard</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="workspace-top-link workspace-top-logout" type="submit">Logout</button>
                </form>
            </div>
        </div>
    </header>
    <main>@RenderBody()</main>
    @if (TempData["ToastMessage"] is string toastMessage)
    {
        var toastType = TempData["ToastType"]?.ToString() ?? "success";
        <div id="uplivaToast" class="upliva-toast upliva-toast-@toastType" role="status" aria-live="polite">
            <div class="upliva-toast-icon">@(toastType == "error" ? "!" : toastType == "info" ? "i" : "✓")</div>
            <div class="upliva-toast-body">
                <strong>@(toastType == "error" ? "Not saved" : toastType == "info" ? "Information" : "Saved successfully")</strong>
                <span>@toastMessage</span>
            </div>
            <button type="button" class="upliva-toast-close" onclick="document.getElementById('uplivaToast')?.remove()" aria-label="Close">×</button>
        </div>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
