<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UplivaAI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="admin-body">
    <header class="admin-header">
        <div class="container admin-nav">
            <a class="platform-brand" asp-controller="Home" asp-action="Index" aria-label="UplivaAI home">
                <span>U</span><strong>UPLIVAAI</strong>
            </a>
            <div class="workspace-top-actions" aria-label="Workspace navigation">
                @if (User.IsInRole(PlatformRoles.Admin))
                {
                    <a class="workspace-top-link" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                }
                else if (User.IsInRole(PlatformRoles.BusinessOwner))
                {
                    <a class="workspace-top-link" asp-controller="BusinessDashboard" asp-action="Index">Dashboard</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="workspace-top-link workspace-top-logout" type="submit">Logout</button>
                </form>
            </div>
        </div>
    </header>
    <main>@RenderBody()</main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
