<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Paradise Palm Resort</title>
    <meta name="description" content="Book your stay at Paradise Palm Resort." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container nav-wrap">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">PP</span>
            <span>
                <strong>Paradise Palm</strong>
                <small>RESORT & SPA</small>
            </span>
        </a>
        <nav class="nav">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Rooms" asp-action="Index">Rooms</a>
            <a asp-controller="Packages" asp-action="Index">Packages</a>
            <a asp-controller="WhatsApp" asp-action="Index">WhatsApp</a>
            <a asp-controller="Booking" asp-action="Index" class="nav-book">Book Now</a>
        </nav>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="footer">
    <div class="container footer-grid">
        <div>
            <div class="brand footer-brand">
                <span class="brand-mark">PP</span>
                <span><strong>Paradise Palm</strong><small>RESORT & SPA</small></span>
            </div>
            <p>A peaceful escape designed for relaxing stays, memorable weekends and family holidays.</p>
        </div>
        <div>
            <h4>Explore</h4>
            <a asp-controller="Rooms" asp-action="Index">Rooms</a>
            <a asp-controller="Packages" asp-action="Index">Packages</a>
            <a asp-controller="WhatsApp" asp-action="Index">WhatsApp</a>
            <a asp-controller="Booking" asp-action="Index">Book a stay</a>
        </div>
        <div>
            <h4>Contact</h4>
            <span>+91 98765 43210</span>
            <span>reservations@paradisepalm.in</span>
            <span>Beach Road, Goa, India</span>
        </div>
    </div>
    <div class="container copyright">© @DateTime.Now.Year Paradise Palm Resort. Powered by UplivaAI.</div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
