@model List<BusinessEnquiry>
@{ var business=(Business)ViewBag.Business; ViewData["Title"]="Business Enquiries"; Layout="_AdminLayout"; }
<section class="admin-page"><div class="container admin-wide">
<div class="admin-head"><div><span class="platform-kicker dark">BUSINESS ENQUIRIES</span><h1>@business.Name</h1><p>Review customer enquiries captured through the WhatsApp workflow and create follow-up actions.</p></div><div class="workspace-actions"><a class="workspace-btn workspace-btn-primary" asp-controller="BusinessFollowUp" asp-action="Index" asp-route-id="@business.Id">Follow-ups</a><a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessContent" asp-action="Index" asp-route-id="@business.Id">Catalog</a></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Phone</th><th>Message</th><th>Source</th><th>Status</th><th>Created</th><th>Action</th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="7" class="admin-empty-cell">No enquiries yet. They appear here as customers message you on WhatsApp.</td></tr>}
@foreach(var item in Model){<tr><td><strong>@item.Name</strong>@if(!string.IsNullOrWhiteSpace(item.Email)){<small>@item.Email</small>}</td><td>@item.PhoneNumber</td><td class="ws-pre">@item.Message</td><td>@item.Source</td><td><span class="status-badge">@item.Status</span></td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td><a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessFollowUp" asp-action="Create" asp-route-id="@business.Id" asp-route-enquiryId="@item.Id">Create follow-up</a></td></tr>}
</tbody></table></div></div></section>
