@model AdminBusinessListViewModel
@{ ViewData["Title"] = "Admin Dashboard"; Layout = "_AdminLayout"; }
<section class="admin-page admin-plan-dashboard">
    <div class="container admin-wide">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">UPLIVAAI ADMIN</span>
                <h1>Business dashboard</h1>
                <p>Interested leads appear here immediately. Once a business is created, the same row gives you direct access to WhatsApp Business and Catalog.</p>
            </div>
            <a class="admin-primary-link" asp-controller="AdminMarketing" asp-action="Index">All leads &amp; CSV →</a>
        </div>

        <div class="admin-dashboard-toolbar">
            <form method="get" asp-action="Index" class="business-selector-form">
                <div class="field">
                    <label for="businessId">Select business</label>
                    <select id="businessId" name="businessId" onchange="this.form.submit()">
                        <option value="">All businesses</option>
                        @foreach (var business in Model.Businesses)
                        {
                            <option value="@business.Id" selected="@(Model.SelectedBusinessId == business.Id ? "selected" : null)">@business.Name · @business.BusinessType</option>
                        }
                    </select>
                </div>
                @if (Model.SelectedBusinessId.HasValue)
                {
                    <a class="workspace-btn workspace-btn-secondary" asp-action="Index">Clear selection</a>
                }
            </form>

            <div class="admin-dashboard-summary">
                <div><strong>@Model.InterestedLeads.Count</strong><span>Interested</span></div>
                <div><strong>@Model.Businesses.Count</strong><span>Active businesses</span></div>
            </div>
        </div>

        @if (Model.UnassignedInterestedLeads.Any())
        {
            <section class="admin-plan-card admin-plan-card-full">
                <div class="admin-plan-card-head">
                    <div>
                        <span class="platform-kicker dark">PLAN NOT SELECTED</span>
                        <h2>Interested leads</h2>
                        <p>Select the confirmed plan from the lead screen. The lead will immediately move into the correct category below.</p>
                    </div>
                    <strong>@Model.UnassignedInterestedLeads.Count()</strong>
                </div>
                @await Html.PartialAsync("_InterestedLeadTable", Model.UnassignedInterestedLeads)
            </section>
        }

        <div class="admin-plan-grid admin-plan-grid-large">
            <section class="admin-plan-card admin-plan-card-full">
                <div class="admin-plan-card-head">
                    <div>
                        <span class="platform-kicker dark">PLAN 01</span>
                        <h2>WhatsApp</h2>
                        <p>WhatsApp-first business setup and catalog showcase.</p>
                    </div>
                    <strong>@Model.WhatsAppLeads.Count()</strong>
                </div>
                @await Html.PartialAsync("_InterestedLeadTable", Model.WhatsAppLeads)
            </section>

            <section class="admin-plan-card admin-plan-card-full">
                <div class="admin-plan-card-head">
                    <div>
                        <span class="platform-kicker dark">PLAN 02</span>
                        <h2>WhatsApp + Website</h2>
                        <p>WhatsApp catalog plus a business website.</p>
                    </div>
                    <strong>@Model.WhatsAppWebsiteLeads.Count()</strong>
                </div>
                @await Html.PartialAsync("_InterestedLeadTable", Model.WhatsAppWebsiteLeads)
            </section>

            <section class="admin-plan-card admin-plan-card-full">
                <div class="admin-plan-card-head">
                    <div>
                        <span class="platform-kicker dark">PLAN 03</span>
                        <h2>WhatsApp + Website + Business Enquiry</h2>
                        <p>WhatsApp, website and customer enquiry management.</p>
                    </div>
                    <strong>@Model.WhatsAppWebsiteEnquiryLeads.Count()</strong>
                </div>
                @await Html.PartialAsync("_InterestedLeadTable", Model.WhatsAppWebsiteEnquiryLeads)
            </section>
        </div>

        <div class="admin-note-card">
            <strong>Workflow</strong>
            <span>Lead captured → Upliva team calls → status changed to Interested → plan selected → lead appears in the correct plan category → Create Business → business becomes active immediately → open WhatsApp Business or Catalog from the same row.</span>
        </div>
    </div>
</section>
