@model AdminBusinessListViewModel
@{ ViewData["Title"] = "Admin Dashboard"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container"><div class="admin-head"><div><span class="platform-kicker dark">UPLIVAAI ADMIN</span><h1>Business approvals</h1><p>Review registrations, approve owners and control which websites are published.</p></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="platform-btn platform-btn-ghost" type="submit">Logout</button></form></div><div class="admin-stats"><div><strong>@Model.Businesses.Count</strong><span>Total businesses</span></div><div><strong>@Model.Businesses.Count(x => x.Status == BusinessStatuses.Pending)</strong><span>Pending</span></div><div><strong>@Model.Businesses.Count(x => x.Status == BusinessStatuses.Approved)</strong><span>Approved</span></div><div><strong>@Model.Businesses.Count(x => x.IsPublished)</strong><span>Published</span></div></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Business</th><th>Type</th><th>Owner</th><th>Status</th><th>Published</th><th>Actions</th></tr></thead><tbody>@foreach (var business in Model.Businesses) { <tr><td><strong>@business.Name</strong><small>@business.Slug</small></td><td>@business.BusinessType</td><td>@business.OwnerName<br /><small>@business.Email</small></td><td><span class="status-badge @business.Status.ToLowerInvariant()">@business.Status</span></td><td>@(business.IsPublished ? "Yes" : "No")</td><td><div class="admin-actions">@if (business.Status == BusinessStatuses.Pending) { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@business.Id" /><button type="submit">Approve</button></form><form asp-action="Reject" method="post"><input type="hidden" name="id" value="@business.Id" /><button type="submit">Reject</button></form> } @if (business.Status == BusinessStatuses.Approved && !business.IsPublished) { <form asp-action="Publish" method="post"><input type="hidden" name="id" value="@business.Id" /><button type="submit">Publish</button></form> } @if (business.IsPublished) { <a asp-controller="BusinessManagement" asp-action="Edit" asp-route-id="@business.Id">Edit</a><a asp-controller="BusinessContent" asp-action="Index" asp-route-id="@business.Id">Content</a><a href="@Url.Action("Website", "Business", new { slug = business.Slug })" target="_blank">Open</a><form asp-action="Unpublish" method="post"><input type="hidden" name="id" value="@business.Id" /><button type="submit">Unpublish</button></form> }</div></td></tr> }</tbody></table></div></div></section>
