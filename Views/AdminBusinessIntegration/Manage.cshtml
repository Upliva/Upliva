@model BusinessIntegrationViewModel
@{
    ViewData["Title"] = "WhatsApp Business";
    Layout = "_AdminLayout";
    var groupedProducts = Model.WhatsAppProducts
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Category) ? "Other" : x.Category.Trim(), StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x.Key);
}

<section class="admin-page">
    <div class="container ws-container-wide">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">WhatsApp setup</span>
                <h1>@Model.BusinessName</h1>
                <p>@Model.BusinessType · @Model.WhatsAppNumber · @BusinessServicePlans.GetDisplayName(Model.ServicePlan)</p>
            </div>
            <div class="workspace-page-actions">
                <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminDashboard" asp-action="Index">← Dashboard</a>
                <a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessContent" asp-action="Index" asp-route-id="@Model.BusinessId">Manage catalog</a>
                <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminWhatsAppMessages" asp-action="Index" asp-route-businessId="@Model.BusinessId">Message history</a>
            </div>
        </div>

        <div class="business-form">
            <form asp-action="Manage" method="post" id="whatsappBusinessForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BusinessId" />
                <input type="hidden" asp-for="BusinessName" />
                <input type="hidden" asp-for="BusinessType" />
                <input type="hidden" asp-for="WhatsAppNumber" />
                <input type="hidden" asp-for="ServicePlan" />
                <div asp-validation-summary="ModelOnly" class="validation"></div>

                <div class="ws-panel-head">
                    <div>
                        <span class="platform-kicker dark">Step 1</span>
                        <h2>Profile &amp; connection</h2>
                        <p class="ws-panel-sub">How the business appears on WhatsApp, and the Meta IDs used to send messages.</p>
                    </div>
                </div>
                <div class="form-grid">
                    <div class="field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" placeholder="Business name shown in WhatsApp" /></div>
                    <div class="field"><label asp-for="BusinessCategory"></label><input asp-for="BusinessCategory" placeholder="e.g. Real Estate" /></div>
                    <div class="field full"><label asp-for="AboutText"></label><textarea asp-for="AboutText" rows="2" placeholder="Short business description"></textarea></div>
                    <div class="field full"><label asp-for="WelcomeMessage"></label><textarea asp-for="WelcomeMessage" rows="3" placeholder="Welcome message sent when a customer starts the chat"></textarea></div>
                    <div class="field"><label asp-for="WabaId"></label><input asp-for="WabaId" placeholder="Meta WABA ID" /></div>
                    <div class="field"><label asp-for="PhoneNumberId"></label><input asp-for="PhoneNumberId" placeholder="Meta Phone Number ID" /></div>
                    <div class="field full"><label asp-for="AccessToken"></label><input asp-for="AccessToken" type="password" autocomplete="new-password" placeholder="Leave blank to use WhatsApp:AccessToken from User Secrets" /><small class="ws-help">For testing, keep this blank when the token is stored in User Secrets/environment configuration. The real token is never displayed.</small></div>
                    <div class="field"><label asp-for="WebhookVerifyToken"></label><input asp-for="WebhookVerifyToken" type="password" autocomplete="off" placeholder="Optional for outbound message testing" /><small class="ws-help">Not required for sending test messages. Configure it later when Meta webhook verification is needed.</small></div>
                    <div class="field"><label asp-for="GraphApiVersion"></label><input asp-for="GraphApiVersion" /></div>
                    <div class="field"><label asp-for="FeaturedProductLimit"></label><input asp-for="FeaturedProductLimit" type="number" min="1" max="50" /></div>
                    <div class="field full"><label class="ws-checkbox"><input asp-for="IsEnabled" /> Enable WhatsApp integration for this business</label></div>
                </div>

                <hr class="ws-divider" />

                <div class="ws-panel-head">
                    <div>
                        <span class="platform-kicker dark">Step 2</span>
                        <h2>WhatsApp catalog</h2>
                        <p class="ws-panel-sub">Tick an item to include it. Rank 1 is shown first. Categories come from your catalog automatically.</p>
                    </div>
                    <span class="top-pick-badge"><span id="selectedCount">@Model.SelectedWhatsAppProductIds.Count</span> / @Model.FeaturedProductLimit selected</span>
                </div>

                @if (Model.WhatsAppProducts.Count == 0)
                {
                    <div class="ws-empty">
                        No catalog items yet. <a asp-controller="BusinessContent" asp-action="Index" asp-route-id="@Model.BusinessId">Add the first catalog item →</a>
                    </div>
                }
                else
                {
                    <div class="ws-filter-bar two-col">
                        <div class="field">
                            <label for="whatsappSearch">Search catalog</label>
                            <input id="whatsappSearch" placeholder="Search property, product or SKU" />
                        </div>
                        <div class="field">
                            <label for="whatsappCategory">Category</label>
                            <select id="whatsappCategory">
                                <option value="">All categories</option>
                                @foreach (var group in groupedProducts)
                                {
                                    <option value="@group.Key">@group.Key (@group.Count())</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div id="whatsappCatalogGroups">
                    @foreach (var group in groupedProducts)
                    {
                        <section class="whatsapp-category-group ws-group" data-category="@group.Key">
                            <div class="ws-group-head">
                                <div>
                                    <strong>@group.Key</strong>
                                    <span>@group.Count() catalog item(s)</span>
                                </div>
                                <button type="button" class="workspace-btn workspace-btn-secondary workspace-btn-sm select-category-btn" data-category="@group.Key">Select visible</button>
                            </div>

                            <div class="whatsapp-product-list">
                            @foreach (var product in group.OrderBy(x => x.Rank > 0 ? x.Rank : int.MaxValue).ThenBy(x => x.Name))
                            {
                                <div class="whatsapp-rank-row ws-rank-row" data-product-id="@product.Id" data-category="@group.Key" data-search="@($"{product.Name} {product.SKU} {product.Category}".ToLowerInvariant())">
                                    <input class="whatsapp-product-checkbox" type="checkbox" name="SelectedWhatsAppProductIds" value="@product.Id" @(product.IsSelected ? "checked" : "") aria-label="Include @product.Name on WhatsApp" />
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img class="ws-thumb" src="@product.ImageUrl" alt="@product.Name" loading="lazy" onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <div class="ws-thumb-empty">No image</div>
                                    }
                                    <span>
                                        <span class="ws-item-name">@product.Name</span>
                                        <span class="ws-item-meta">@product.Category @(!string.IsNullOrWhiteSpace(product.SKU) ? "· SKU " + product.SKU : "")</span>
                                    </span>
                                    <span class="ws-price">@product.PriceText</span>
                                    <input class="whatsapp-rank-input" type="number" min="1" max="50" name="WhatsAppProductRanks[@product.Id]" value="@(product.Rank > 0 ? product.Rank : "")" placeholder="#" @(product.IsSelected ? "" : "disabled") aria-label="Rank for @product.Name" />
                                </div>
                            }
                            </div>
                        </section>
                    }
                    </div>
                }

                <div class="ws-form-actions">
                    <button id="saveWhatsAppButton" class="platform-btn platform-btn-primary" type="submit">Save WhatsApp setup</button>
                    <span class="ws-muted">Only ticked products are included. Ranks are renumbered 1…N on save, so the order is always clean.</span>
                </div>
            </form>
        </div>

        <div class="ws-card-accent">
            <div class="ws-panel-head">
                <div>
                    <span class="top-pick-badge">Outbound test</span>
                    <h2>Send the catalog to your WhatsApp</h2>
                    <p class="ws-panel-sub">Uses this business's Meta Phone Number ID and Access Token. The webhook and the enable switch aren't needed for this test.</p>
                </div>
                <div class="ws-stat-tile">
                    <strong>@Model.SelectedWhatsAppProductIds.Count</strong>
                    <span>selected products</span>
                </div>
            </div>

            @if (Model.PlatformWhatsAppConfigured)
            {
                <div class="ws-callout ws-callout-success ws-mt-0">
                    <strong>✓ Meta outbound credentials detected.</strong>
                    <span>Phone Number ID and Access Token are available from your existing <code>WhatsApp:*</code> configuration.</span>
                </div>
            }
            else
            {
                <div class="ws-callout ws-callout-danger ws-mt-0">
                    <strong>Meta outbound credentials not detected.</strong>
                    <span>Add <code>WhatsApp:PhoneNumberId</code> and <code>WhatsApp:AccessToken</code> to your existing User Secrets/environment configuration.</span>
                </div>
            }

            <form asp-action="SendCatalog" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BusinessId" />
                <div class="ws-send-grid">
                    <div class="field">
                        <label for="testRecipientPhoneNumber">Your WhatsApp number</label>
                        <input id="testRecipientPhoneNumber" name="testRecipientPhoneNumber" value="@Model.TestRecipientPhoneNumber" placeholder="919798555992" autocomplete="tel" required />
                        <small class="ws-help">Country code first, e.g. <strong>919798555992</strong>. No + or spaces.</small>
                    </div>
                    <div class="field">
                        <label for="catalogSendMode">What should be sent?</label>
                        <select id="catalogSendMode" name="catalogSendMode">
                            <option value="selected">Selected WhatsApp products (@Model.SelectedWhatsAppProductIds.Count)</option>
                            <option value="all">All active catalog products (@Model.WhatsAppProducts.Count)</option>
                        </select>
                    </div>
                </div>
                <div class="ws-subform">
                    <button id="sendCatalogButton" class="platform-btn platform-btn-primary" type="submit">Send catalog now</button>
                    <span class="ws-muted">Products are sent as text in saved rank order. This avoids remote-image delivery issues; images can be tested separately.</span>
                </div>
            </form>

            <div class="ws-subform">
                <form asp-action="SendTestMessage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BusinessId" />
                    <input type="hidden" id="diagnosticRecipient" name="testRecipientPhoneNumber" value="@Model.TestRecipientPhoneNumber" />
                    <button class="workspace-btn workspace-btn-secondary" type="submit">Send one test text first</button>
                </form>
                <form asp-action="TestWhatsApp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BusinessId" />
                    <button class="workspace-btn workspace-btn-secondary" type="submit">Test WhatsApp connection</button>
                </form>
                <span class="ws-muted">Having trouble? The test text shows the exact Meta error instead of a generic failure.</span>
            </div>

            <div class="ws-callout ws-callout-warning">
                <strong>Testing tip:</strong> first send <strong>Hi</strong> from your personal WhatsApp number to the Meta test number, then click <strong>Send catalog now</strong>. This opens a customer conversation window for the free-form catalog messages.
            </div>
        </div>

        <div class="ws-callout ws-callout-neutral">
            <strong>Webhook:</strong> <code>/webhooks/whatsapp</code><br />
            Meta/WABA onboarding and phone-number ownership still happen in Meta. This page stores the per-business WhatsApp connection, profile message and catalog showcase configuration used by UplivaAI.
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const form = document.getElementById('whatsappBusinessForm');
    const button = document.getElementById('saveWhatsAppButton');
    const limitInput = document.getElementById('FeaturedProductLimit');
    const count = document.getElementById('selectedCount');
    const search = document.getElementById('whatsappSearch');
    const category = document.getElementById('whatsappCategory');
    const rows = [...document.querySelectorAll('.whatsapp-rank-row')];
    const groups = [...document.querySelectorAll('.whatsapp-category-group')];
    const recipient = document.getElementById('testRecipientPhoneNumber');
    const diagnosticRecipient = document.getElementById('diagnosticRecipient');
    if (recipient && diagnosticRecipient) {
        const syncDiagnosticRecipient = () => diagnosticRecipient.value = recipient.value;
        recipient.addEventListener('input', syncDiagnosticRecipient);
        syncDiagnosticRecipient();
    }

    const refreshCountAndRanks = () => {
        const selected = rows.filter(row => row.querySelector('.whatsapp-product-checkbox')?.checked);
        if (count) count.textContent = selected.length;
        selected.forEach((row, index) => {
            const rank = row.querySelector('.whatsapp-rank-input');
            if (rank && !rank.value) rank.value = index + 1;
        });
        rows.forEach(row => {
            const checkbox = row.querySelector('.whatsapp-product-checkbox');
            const rank = row.querySelector('.whatsapp-rank-input');
            if (rank) rank.disabled = !checkbox?.checked;
        });
    };

    const filter = () => {
        const q = (search?.value || '').trim().toLowerCase();
        const cat = (category?.value || '').trim().toLowerCase();
        groups.forEach(group => {
            const groupCategory = (group.dataset.category || '').toLowerCase();
            let visible = 0;
            group.querySelectorAll('.whatsapp-rank-row').forEach(row => {
                const matchesText = !q || (row.dataset.search || '').includes(q);
                const matchesCategory = !cat || groupCategory === cat;
                const show = matchesText && matchesCategory;
                row.style.display = show ? 'grid' : 'none';
                if (show) visible++;
            });
            group.style.display = visible ? 'block' : 'none';
        });
    };

    rows.forEach(row => row.querySelector('.whatsapp-product-checkbox')?.addEventListener('change', () => {
        const limit = Number(limitInput?.value || 6);
        const selected = rows.filter(x => x.querySelector('.whatsapp-product-checkbox')?.checked);
        if (selected.length > limit) {
            row.querySelector('.whatsapp-product-checkbox').checked = false;
            alert(`You can select up to ${limit} WhatsApp products.`);
        }
        refreshCountAndRanks();
    }));

    document.querySelectorAll('.select-category-btn').forEach(button => {
        button.addEventListener('click', () => {
            const cat = button.dataset.category;
            const group = groups.find(x => (x.dataset.category || '') === cat);
            if (!group) return;
            const limit = Number(limitInput?.value || 6);
            let selectedCount = rows.filter(x => x.querySelector('.whatsapp-product-checkbox')?.checked).length;
            group.querySelectorAll('.whatsapp-rank-row').forEach(row => {
                const checkbox = row.querySelector('.whatsapp-product-checkbox');
                if (!checkbox?.checked && selectedCount < limit) {
                    checkbox.checked = true;
                    selectedCount++;
                }
            });
            refreshCountAndRanks();
        });
    });

    search?.addEventListener('input', filter);
    category?.addEventListener('change', filter);

    if (form && button) form.addEventListener('submit', () => {
        button.disabled = true;
        button.textContent = 'Saving…';
    });

    const sendCatalogButton = document.getElementById('sendCatalogButton');
    const sendCatalogForm = sendCatalogButton?.closest('form[action$="SendCatalog"]');
    if (sendCatalogForm && sendCatalogButton) {
        sendCatalogForm.addEventListener('submit', () => {
            sendCatalogButton.disabled = true;
            sendCatalogButton.textContent = 'Sending catalog…';
        });
    }

    refreshCountAndRanks();
})();
</script>
}
