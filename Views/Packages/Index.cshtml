@model List<Package>
@{
    ViewData["Title"] = "Packages";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">SPECIAL MOMENTS</span>
        <h1>Resort packages</h1>
        <p>Curated stays with more included and less to plan.</p>
    </div>
</section>

<section class="section">
    <div class="container cards-3">
        @foreach (var package in Model)
        {
            <article class="package-card">
                <div class="package-image tall" style="background-image:url('@package.ImageUrl')"></div>
                <div class="card-body">
                    <span class="pill">@package.DurationNights nights</span>
                    <h3>@package.Name</h3>
                    <p>@package.Description</p>
                    <div class="package-bottom">
                        <strong>₹@package.Price.ToString("N0")</strong>
                        <a class="text-link" asp-controller="Booking" asp-action="Index">Book →</a>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
