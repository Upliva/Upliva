@model UplivaAI.Models.WhatsAppTemplateConfiguration
@{ ViewData["Title"] = Model.Id == 0 ? "Add WhatsApp Template" : "Edit WhatsApp Template"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container admin-narrow"><div class="admin-head"><div><span class="platform-kicker dark">ADMIN</span><h1>@ViewData["Title"]</h1><p>Store the provider-approved template contract here. The Gupshup API key stays in User Secrets. The Template ID is the ID supplied by Gupshup for the approved template.</p></div><a class="workspace-btn workspace-btn-secondary" asp-action="Index">← Back</a></div><form method="post" class="business-form"><input type="hidden" asp-for="Id"/>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field"><label asp-for="Name"></label><input asp-for="Name" placeholder="Furniture promotion"/></div><div class="field"><label asp-for="Provider"></label><input asp-for="Provider"/></div><div class="field"><label asp-for="ProviderTemplateName">Gupshup Template ID</label><input asp-for="ProviderTemplateName" placeholder="Gupshup approved template ID"/></div><div class="field"><label asp-for="LanguageCode"></label><input asp-for="LanguageCode" placeholder="en_US"/></div><div class="field"><label asp-for="Category"></label><select asp-for="Category"><option>MARKETING</option><option>UTILITY</option><option>AUTHENTICATION</option></select></div><div class="field"><label asp-for="ButtonText"></label><input asp-for="ButtonText"/></div><div class="field full"><label asp-for="BodyText"></label><textarea asp-for="BodyText" rows="6" placeholder="Hello {{BusinessName}}..."></textarea></div><div class="field full"><label asp-for="ButtonUrlTemplate"></label><input asp-for="ButtonUrlTemplate" placeholder="https://your-domain/business/{{Slug}}"/><span class="field-hint">Use placeholders such as {{BusinessName}}, {{Slug}}. The sender will resolve these later.</span></div><div class="field"><label><input asp-for="IsActive"/> Active</label></div><div class="field"><label><input asp-for="IsDefault"/> Default template</label></div></div><div class="ws-form-actions"><button class="platform-btn platform-btn-primary">Save template</button><a class="workspace-btn workspace-btn-secondary" asp-action="Index">Cancel</a></div></form></div></section>
