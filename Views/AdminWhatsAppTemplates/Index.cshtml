@model IReadOnlyList<UplivaAI.Models.WhatsAppTemplateConfiguration>
@{ ViewData["Title"] = "WhatsApp Templates"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container admin-wide"><div class="admin-head"><div><span class="platform-kicker dark">MESSAGE CONFIGURATION</span><h1>WhatsApp templates</h1><p>Admin-managed approved Gupshup/WhatsApp templates. Sending is intentionally kept separate so the provider can be changed later.</p></div><a class="workspace-btn workspace-btn-primary" asp-action="Create">+ Add template</a></div><div class="admin-note-card ws-mt-0 ws-mb-24"><strong>Gupshup send is server-side</strong><span>Open <b>Send</b> on an approved template, enter the customer's WhatsApp number and template values, and UplivaAI will send it through Gupshup. The API key remains in User Secrets.</span></div><div class="ws-table-scroll"><table class="admin-table"><thead><tr><th>Name</th><th>Provider template</th><th>Category</th><th>Language</th><th>Default</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Name</strong><div class="ws-item-meta">@item.BodyText</div></td><td>@item.ProviderTemplateName</td><td>@item.Category</td><td>@item.LanguageCode</td><td>@(item.IsDefault?"Yes":"—")</td><td>@(item.IsActive?"Active":"Inactive")</td><td><a class="workspace-btn workspace-btn-primary workspace-btn-sm" asp-action="Send" asp-route-id="@item.Id">Send</a> <a class="workspace-btn workspace-btn-secondary workspace-btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('Delete this template?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button class="workspace-btn workspace-btn-danger workspace-btn-sm">Delete</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="7">No templates configured yet.</td></tr>}</tbody></table></div></div></section>
