@model Business
@{ ViewData["Title"] = "WhatsApp Business Dashboard"; Layout = "_AdminLayout"; }
<section class="admin-page">
    <div class="container">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">WHATSAPP BUSINESS</span>
                <h1>@Model.Name</h1>
                <p>@Model.BusinessType · @Model.Status · WhatsApp-first business workspace</p>
            </div>
            <div class="admin-head-actions workspace-actions">
                <a class="workspace-btn workspace-btn-primary" asp-controller="BusinessContent" asp-action="Index">Catalog</a>
                <a class="workspace-btn workspace-btn-secondary" asp-controller="AdminBusinessIntegration" asp-action="Manage" asp-route-id="@Model.Id">WhatsApp setup</a>
                <a class="workspace-btn" asp-controller="BusinessEnquiry" asp-action="Index">Enquiries</a>
                <a class="workspace-btn" asp-controller="BusinessFollowUp" asp-action="Index">Follow-ups</a>
            </div>
        </div>

        <div class="admin-stats">
            <div><strong>@ViewBag.CatalogCount</strong><span>Catalog items</span></div>
            <div><strong>@ViewBag.WhatsAppSelectedCount</strong><span>WhatsApp products</span></div>
            <div><a class="admin-stat-link" asp-controller="BusinessEnquiry" asp-action="Index"><strong>@ViewBag.EnquiryCount</strong><span>Enquiries</span></a></div>
            <div><strong>@ViewBag.MessageCount</strong><span>Messages</span></div>
            <div><strong>@ViewBag.FollowUpCount</strong><span>Open follow-ups</span></div>
        </div>

        <div class="owner-info-grid">
            <article><span>Business</span><h3>@Model.Name</h3><p>@Model.Description</p><p>@Model.Address, @Model.City, @Model.State</p></article>
            <article><span>WhatsApp number</span><h3>@Model.WhatsAppNumber</h3><p>@(ViewBag.WhatsAppEnabled == true ? "WhatsApp integration is enabled." : "WhatsApp integration is not enabled yet.")</p></article>
            <article><span>Catalog engine</span><h3>@ViewBag.CatalogTemplateKey</h3><p>Business-specific fields are rendered from the catalog template and stored with the catalog item.</p></article>
        </div>
    </div>
</section>
