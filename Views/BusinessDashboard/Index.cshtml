@model Business
@{ ViewData["Title"] = "Business Dashboard"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container"><div class="admin-head"><div><span class="platform-kicker dark">BUSINESS OWNER</span><h1>@Model.Name</h1><p>@Model.BusinessType · @Model.Status · @(Model.IsPublished ? "Published" : "Not published")</p></div><div class="admin-head-actions"><a class="platform-btn platform-btn-ghost" asp-controller="BusinessManagement" asp-action="Edit">Edit profile</a><a class="platform-btn platform-btn-ghost" asp-controller="BusinessContent" asp-action="Index">Manage content</a><a class="platform-btn platform-btn-primary" asp-controller="Business" asp-action="Website" asp-route-slug="@Model.Slug" target="_blank">View website →</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="platform-btn platform-btn-ghost" type="submit">Logout</button></form></div></div><div class="admin-stats"><div><strong>@ViewBag.CatalogCount</strong><span>Catalog items</span></div><div><strong>@ViewBag.OfferCount</strong><span>Offers</span></div><div><strong>@ViewBag.EnquiryCount</strong><span>Enquiries</span></div><div><strong>@(Model.IsPublished ? "LIVE" : "PENDING")</strong><span>Website status</span></div></div><div class="owner-info-grid"><article><span>Business details</span><h3>@Model.Name</h3><p>@Model.Description</p><p>@Model.Address, @Model.City</p></article><article><span>WhatsApp</span><h3>@Model.WhatsAppNumber</h3><p>WhatsApp configuration can be connected to this business after the base approval flow is complete.</p></article><article><span>Admin publishing</span><h3>@(Model.IsPublished ? "Published" : "Waiting for admin")</h3><p>The business owner cannot publish or approve the public website.</p></article></div></div></section>
