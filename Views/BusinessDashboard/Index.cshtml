@model Business
@{ ViewData["Title"] = "Business Dashboard"; Layout = "_AdminLayout"; }
<section class="admin-page">
    <div class="container">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">BUSINESS OWNER</span>
                <h1>@Model.Name</h1>
                <p>@Model.BusinessType · @Model.Status · @(Model.IsPublished ? "Published" : "Not published")</p>
            </div>
            <div class="admin-head-actions workspace-actions" aria-label="Business workspace actions">
                <a class="workspace-btn" asp-controller="BusinessManagement" asp-action="Edit">Edit profile</a>
                <a class="workspace-btn" asp-controller="BusinessManagement" asp-action="WebsiteContent">Website content</a>
                <a class="workspace-btn" asp-controller="BusinessContent" asp-action="Index">Catalog &amp; offers</a>
                <a class="workspace-btn workspace-btn-primary" asp-controller="Business" asp-action="Website" asp-route-slug="@Model.Slug">View website <span aria-hidden="true">→</span></a>
            </div>
        </div>

        <div class="workspace-backup-actions">
            <span>Business workspace</span>
            <a asp-controller="BusinessManagement" asp-action="Edit">Edit profile</a>
            <a asp-controller="BusinessManagement" asp-action="WebsiteContent">Website content</a>
            <a asp-controller="BusinessContent" asp-action="Index">Catalog &amp; offers</a>
        </div>

        <div class="admin-stats">
            <div><strong>@ViewBag.CatalogCount</strong><span>Catalog items</span></div>
            <div><strong>@ViewBag.OfferCount</strong><span>Offers</span></div>
            <div><strong>@ViewBag.EnquiryCount</strong><span>Enquiries</span></div>
            <div><strong>@(Model.IsPublished ? "LIVE" : "PENDING")</strong><span>Website status</span></div>
        </div>

        <div class="owner-info-grid">
            <article><span>Business details</span><h3>@Model.Name</h3><p>@Model.Description</p><p>@Model.Address, @Model.City, @Model.State - @Model.PostalCode</p></article>
            <article><span>WhatsApp</span><h3>@Model.WhatsAppNumber</h3><p>WhatsApp configuration can be connected to this business after the base approval flow is complete.</p></article>
            <article><span>Admin publishing</span><h3>@(Model.IsPublished ? "Published" : "Waiting for admin")</h3><p>The business owner cannot publish or approve the public website.</p></article>
        </div>
    </div>
</section>
