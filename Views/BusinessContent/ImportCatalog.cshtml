@model CatalogImportViewModel
@{
    ViewData["Title"] = "Import Catalog";
    Layout = "_AdminLayout";
}
<section class="admin-page">
    <div class="container admin-narrow ws-container-sm">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">CATALOG TEST CENTER</span>
                <h1>Import catalog data</h1>
                <p>@Model.BusinessName · @Model.TemplateDisplayName. Upload a CSV or JSON file and UplivaAI will map common fields and dynamic template fields automatically.</p>
            </div>
            <a class="workspace-btn workspace-btn-secondary" asp-action="Index" asp-route-id="@Model.BusinessId">← Back to catalog</a>
        </div>

        <div class="admin-note-card">
            <strong>Testing path</strong>
            <span>Download template → fill multiple products → upload → validate → import → return to catalog → select WhatsApp products → preview. Product Name is the only required catalog value.</span>
        </div>

        @if (Model.Errors.Count > 0)
        {
            <div class="validation ws-mb-24">
                <strong>Please correct these items before importing:</strong>
                <ul>@foreach (var error in Model.Errors) { <li>@error</li> }</ul>
            </div>
        }

        <div class="business-form">
            <form asp-action="ImportCatalog" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BusinessId" />
                <div class="form-grid">
                    <div class="field full">
                        <label asp-for="File">Catalog file</label>
                        <input asp-for="File" type="file" accept=".csv,.json,text/csv,application/json" />
                        <small class="ws-help">Supported: CSV and JSON · Maximum 10 MB · Common headers and dynamic field keys/labels are mapped automatically.</small>
                    </div>
                </div>
                <div class="ws-form-actions">
                    <button type="submit" class="platform-btn platform-btn-primary">Validate &amp; import</button>
                    <a class="workspace-btn workspace-btn-secondary" asp-action="DownloadCatalogTemplate" asp-route-id="@Model.BusinessId">Download CSV template</a>
                </div>
            </form>
        </div>

        <div class="admin-note-card">
            <strong>Dynamic fields and dropdown options</strong>
            <span>Template: <b>@Model.TemplateKey</b>. All fields are optional. For dropdown fields, the imported value must match one of the configured options.</span>
            <div class="ws-grid-tiles">
                @foreach (var field in (IEnumerable<CatalogFieldDefinition>)(ViewBag.CatalogFields ?? Array.Empty<CatalogFieldDefinition>()))
                {
                    <div class="ws-field-tile">
                        <strong>@field.Label</strong> <small>(@field.Key)</small>
                        <span class="ws-item-meta">Type: @field.Type · Optional</span>
                        @if (field.Options.Count > 0)
                        {
                            <span class="ws-item-sku">Options: @string.Join(" · ", field.Options)</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (Model.PreviewRows.Count > 0)
        {
            <div class="admin-table-wrap ws-mt-24">
                <table class="admin-table">
                    <thead><tr><th>Row</th><th>Product Name</th><th>Category</th><th>Price</th><th>Status</th></tr></thead>
                    <tbody>@foreach (var row in Model.PreviewRows) { <tr><td>@row.RowNumber</td><td><strong>@row.ProductName</strong></td><td>@row.Category</td><td>@row.PriceText</td><td>@row.Status</td></tr> }</tbody>
                </table>
            </div>
        }
    </div>
</section>
