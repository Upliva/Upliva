@model BusinessCatalogItemViewModel
@{ var business = (Business)ViewBag.Business; var catalog = (List<BusinessCatalogItem>)ViewBag.Catalog; var offers = (List<BusinessOffer>)ViewBag.Offers; ViewData["Title"] = "Business Content"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container"><div class="admin-head"><div><span class="platform-kicker dark">CONTENT MANAGEMENT</span><h1>@business.Name</h1><p>Add products/services and hot deals for the reusable public website.</p></div></div><div class="content-admin-grid"><div class="business-form"><h2>Add catalog item</h2><form asp-action="AddCatalog" method="post"><input type="hidden" asp-for="BusinessId" /><div class="field"><label asp-for="Name"></label><input asp-for="Name" /></div><div class="field"><label asp-for="Category"></label><input asp-for="Category" /></div><div class="field"><label asp-for="PriceText"></label><input asp-for="PriceText" placeholder="From ₹999" /></div><div class="field"><label asp-for="ImageUrl"></label><input asp-for="ImageUrl" /></div><div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea></div><button class="platform-btn platform-btn-primary" type="submit">Add item</button></form></div><div class="business-form"><h2>Add hot deal</h2><form asp-action="AddOffer" method="post"><input type="hidden" name="BusinessId" value="@business.Id" /><div class="field"><label>Title</label><input name="Title" required /></div><div class="field"><label>Discount</label><input name="DiscountText" placeholder="10% OFF" /></div><div class="field"><label>Image URL</label><input name="ImageUrl" /></div><div class="field"><label>Description</label><textarea name="Description" rows="4"></textarea></div><button class="platform-btn platform-btn-primary" type="submit">Add deal</button></form></div></div><div class="content-list"><h2>Current catalog</h2>@foreach (var item in catalog) { <div class="content-row"><strong>@item.Name</strong><span>@item.Category</span><span>@item.PriceText</span></div> }<h2>Current deals</h2>@foreach (var offer in offers) { <div class="content-row"><strong>@offer.Title</strong><span>@offer.DiscountText</span><span>@(offer.IsPublished ? "Published" : "Waiting for admin")</span>@if (!offer.IsPublished && User.IsInRole(PlatformRoles.Admin)) { <form asp-action="PublishOffer" method="post"><input type="hidden" name="id" value="@offer.Id" /><button type="submit">Publish</button></form> }</div> }</div></div></section>
