@model BusinessCatalogItemViewModel
@{
    var business = (Business)ViewBag.Business;
    var catalog = (List<BusinessCatalogItem>)ViewBag.Catalog;
    var offers = (List<BusinessOffer>)ViewBag.Offers;
    var topPickCount = (int)(ViewBag.TopPickCount ?? 0);
    ViewData["Title"] = "Catalog & Offers";
    Layout = "_AdminLayout";
}

<section class="admin-page">
    <div class="container">
        <div class="admin-head">
            <div>
                <span class="platform-kicker dark">CATALOG MANAGEMENT</span>
                <h1>@business.Name</h1>
                <p>Add the product once and reuse it across the generated business website and WhatsApp. Website content such as About, Services and other business text is managed separately.</p>
            </div>
        </div>

        @if (TempData["CatalogSuccess"] is not null)
        {
            <div class="success-banner" style="margin-bottom:20px">@TempData["CatalogSuccess"]</div>
        }
        @if (TempData["CatalogError"] is not null)
        {
            <div class="validation" style="margin-bottom:20px">@TempData["CatalogError"]</div>
        }
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="content-admin-grid">
            <div class="business-form">
                <div style="display:flex;justify-content:space-between;gap:15px;align-items:flex-start;flex-wrap:wrap">
                    <div>
                        <h2>Add catalog product</h2>
                        <p style="color:#687284;font-size:13px;margin-top:-8px">Use product details similar to a marketplace listing.</p>
                    </div>
                    <span class="top-pick-badge">@topPickCount / 6 WhatsApp Top Picks</span>
                </div>

                <form asp-action="AddCatalog" method="post">
                    <input type="hidden" asp-for="BusinessId" />

                    <div class="form-grid">
                        <div class="field full">
                            <label asp-for="Name"></label>
                            <input asp-for="Name" placeholder="iPhone 18 Pro (1 TB) - Burgundy" />
                            <span asp-validation-for="Name" class="validation"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Brand"></label>
                            <input asp-for="Brand" placeholder="Apple" />
                        </div>
                        <div class="field">
                            <label asp-for="Model"></label>
                            <input asp-for="Model" placeholder="iPhone 18 Pro" />
                        </div>

                        <div class="field">
                            <label asp-for="SKU"></label>
                            <input asp-for="SKU" placeholder="IP18P-1TB-BRG" />
                        </div>
                        <div class="field">
                            <label asp-for="Category"></label>
                            <input asp-for="Category" placeholder="Smartphones" />
                        </div>

                        <div class="field">
                            <label asp-for="PriceText"></label>
                            <input asp-for="PriceText" placeholder="₹2,39,900" />
                        </div>
                        <div class="field">
                            <label asp-for="OriginalPriceText"></label>
                            <input asp-for="OriginalPriceText" placeholder="₹2,49,900" />
                        </div>

                        <div class="field">
                            <label asp-for="DiscountText"></label>
                            <input asp-for="DiscountText" placeholder="4% OFF" />
                        </div>
                        <div class="field">
                            <label asp-for="StockStatus"></label>
                            <input asp-for="StockStatus" placeholder="In stock · 2 left" />
                        </div>

                        <div class="field full">
                            <label asp-for="ImageUrl"></label>
                            <input asp-for="ImageUrl" placeholder="https://example.com/product-image.jpg" />
                            <span asp-validation-for="ImageUrl" class="validation"></span>
                            <div style="font-size:11px;color:#687284;margin-top:7px">For now use a public image URL. Later this field can point to your Azure Blob image URL without changing the catalog model.</div>
                        </div>

                        <div class="field full">
                            <label asp-for="ShortDescription"></label>
                            <input asp-for="ShortDescription" placeholder="6.3-inch display, ProMotion, A20 Pro chip, 48MP Fusion camera" />
                        </div>

                        <div class="field full">
                            <label asp-for="Description"></label>
                            <textarea asp-for="Description" rows="4" placeholder="Add the full product description, key features, warranty or service information."></textarea>
                        </div>

                        <div class="field">
                            <label asp-for="Rating"></label>
                            <input asp-for="Rating" type="number" step="0.1" min="0" max="5" placeholder="4.5" />
                        </div>
                        <div class="field">
                            <label asp-for="ReviewCount"></label>
                            <input asp-for="ReviewCount" type="number" min="0" placeholder="125" />
                        </div>

                        <div class="field">
                            <label asp-for="SortOrder"></label>
                            <input asp-for="SortOrder" type="number" min="0" placeholder="1" />
                        </div>
                        <div class="field" style="display:flex;align-items:center;gap:10px;padding-top:28px">
                            <input asp-for="ShowOnWebsite" style="width:auto" />
                            <label asp-for="ShowOnWebsite" style="margin:0">Show on business website</label>
                        </div>
                        <div class="field" style="display:flex;align-items:center;gap:10px;padding-top:28px">
                            <input asp-for="IsWhatsAppTopPick" style="width:auto" />
                            <label asp-for="IsWhatsAppTopPick" style="margin:0">Show in WhatsApp Top 6</label>
                        </div>
                    </div>

                    <div style="background:#f7faf8;border:1px solid #e1ece5;border-radius:12px;padding:14px;margin:4px 0 18px;color:#536074;font-size:12px">
                        <strong>How this works:</strong> every product can be shown on the business website. Select <strong>WhatsApp Top 6</strong> for up to 6 products; those products are sent through WhatsApp and are highlighted first on the website. A product selected for WhatsApp Top 6 is automatically kept visible on the website.
                    </div>

                    <div style="background:#fffaf0;border:1px solid #f1dfb4;border-radius:12px;padding:14px;margin:0 0 18px;color:#536074;font-size:12px">
                        <strong>Mobile shop demo:</strong> use the sample product/image URLs I provided with this release. These are temporary public demo images; replace them with your own product images or Azure Blob URLs later.
                    </div>
                    <button class="platform-btn platform-btn-primary" type="submit">Add product</button>
                </form>
            </div>

            <div class="business-form">
                <h2>Add hot deal</h2>
                <form asp-action="AddOffer" method="post">
                    <input type="hidden" name="BusinessId" value="@business.Id" />
                    <div class="field"><label>Title</label><input name="Title" required placeholder="Weekend Smartphone Offer" /></div>
                    <div class="field"><label>Discount</label><input name="DiscountText" placeholder="10% OFF" /></div>
                    <div class="field"><label>Image URL</label><input name="ImageUrl" /></div>
                    <div class="field"><label>Description</label><textarea name="Description" rows="4"></textarea></div>
                    <button class="platform-btn platform-btn-primary" type="submit">Add deal</button>
                </form>
            </div>
        </div>

        <div class="content-list" style="margin-top:25px">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
                <div>
                    <h2>Current catalog</h2>
                    <p style="color:#687284;font-size:12px">The catalog is shared across the generated website and WhatsApp. Use website visibility and Top 6 independently.</p>
                </div>
                <span class="top-pick-badge">Top 6 selected: @topPickCount / 6</span>
            </div>

            @if (catalog.Count == 0)
            {
                <div class="content-row"><span>No products added yet.</span></div>
            }
            else
            {
                @foreach (var item in catalog)
                {
                    <div class="content-row" style="grid-template-columns:2fr 1fr 1fr 1fr auto;">
                        <div>
                            <strong>@item.Name</strong>
                            <div style="font-size:10px;color:#89919e;margin-top:3px">@item.Brand @item.Model</div>
                        </div>
                        <span>@item.Category</span>
                        <span>@item.PriceText</span>
                        <span>@(item.IsWhatsAppTopPick ? "WhatsApp Top 6" : (item.ShowOnWebsite ? "Website" : "Hidden"))</span>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <form asp-action="ToggleWhatsAppTopPick" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit">@(item.IsWhatsAppTopPick ? "Remove Top 6" : "Add to Top 6")</button>
                            </form>
                            <form asp-action="DeleteCatalog" method="post" onsubmit="return confirm('Remove this product from the catalog?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            }

            <h2 style="margin-top:35px">Current deals</h2>
            @foreach (var offer in offers)
            {
                <div class="content-row">
                    <strong>@offer.Title</strong>
                    <span>@offer.DiscountText</span>
                    <span>@(offer.IsPublished ? "Published" : "Waiting for admin")</span>
                    @if (!offer.IsPublished && User.IsInRole(PlatformRoles.Admin))
                    {
                        <form asp-action="PublishOffer" method="post">
                            <input type="hidden" name="id" value="@offer.Id" />
                            <button type="submit">Publish</button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</section>
