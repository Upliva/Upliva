@model BusinessWebsiteViewModel
@{
    ViewData["Title"] = Model.Business.Name;
    ViewData["BrowserTitle"] = string.IsNullOrWhiteSpace(Model.Configuration.WebsiteTitle) ? Model.Business.Name : Model.Configuration.WebsiteTitle;
    Layout = "_BusinessWebsiteLayout";
    var config = Model.Configuration;
    var topPickIds = Model.TopCatalog.Select(x => x.Id).ToHashSet();
    var remainingCatalog = Model.Catalog.Where(x => !topPickIds.Contains(x.Id)).ToList();
    var heroImage = string.IsNullOrWhiteSpace(Model.Business.HeroImageUrl) ? "~/images/upliva/business-hero-placeholder.svg" : Model.Business.HeroImageUrl;
    var metaDescription = string.IsNullOrWhiteSpace(config.MetaDescription) ? Model.Business.Description : config.MetaDescription;
}

@section Head {
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
}

<style>
    .business-site { --business-primary:@config.PrimaryColor; --business-accent:@config.AccentColor; }
    .product-meta { display:flex; gap:10px; flex-wrap:wrap; color:#687284; font-size:12px; margin:7px 0; }
    .product-price { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:12px; }
    .product-price strong { color:#173d2d; font-size:18px; }
    .product-price del { color:#89919e; font-size:13px; }
    .product-discount { color:#0b8f58; font-weight:800; font-size:12px; }
    .product-stock { display:inline-block; margin-top:8px; font-size:11px; font-weight:700; color:#536074; }
    .product-rating { font-size:12px; font-weight:700; color:#445064; }
    .top-pick-badge { display:inline-block; background:#edf8f2; color:#0c8b56; padding:5px 9px; border-radius:999px; font-size:10px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; }
    .product-details { padding-top:2px; }
    .product-details h3 { margin:8px 0 4px; }
    .product-details p { margin:5px 0; }
    .website-copy { white-space:pre-line; line-height:1.8; color:#536074; }
    .website-text-card { background:#f7faf8; border:1px solid #e2ebe6; border-radius:18px; padding:28px; }
    .business-platform-note { font-size:12px; color:#687284; }
    .upliva-business-platform-footer { background:#f7faf8; border-top:1px solid #e2ebe6; padding:48px 0 56px; }
    .upliva-business-platform-footer-inner { display:flex; align-items:center; justify-content:space-between; gap:28px; flex-wrap:wrap; }
    .upliva-business-platform-brand { display:inline-flex; margin-top:10px; }
    .upliva-business-platform-brand img { width:150px; height:auto; display:block; }
    .upliva-business-platform-footer p { color:#687284; margin:8px 0 0; max-width:560px; }
</style>

<section class="business-hero" style="background-image:linear-gradient(90deg,rgba(5,20,17,.82),rgba(5,20,17,.25)),url('@heroImage')">
    <div class="container business-hero-inner">
        <span class="platform-kicker">@Model.Business.BusinessType</span>
        <h1>@(string.IsNullOrWhiteSpace(config.HeroTitle) ? Model.Business.Name : config.HeroTitle)</h1>
        <p>@(string.IsNullOrWhiteSpace(config.HeroSubtitle) ? Model.Business.Tagline : config.HeroSubtitle)</p>
        <div class="platform-actions">
            <a class="platform-btn platform-btn-primary" href="#enquiry">Contact business →</a>
            @if (config.ShowWhatsApp && !string.IsNullOrWhiteSpace(Model.Business.WhatsAppNumber))
            {
                <a class="platform-btn platform-btn-light" href="https://wa.me/@Model.Business.WhatsAppNumber" target="_blank" rel="noopener">WhatsApp us</a>
            }
        </div>
    </div>
</section>

<section class="platform-section business-about" id="about">
    <div class="container business-about-grid">
        <div>
            <span class="platform-kicker dark">ABOUT THE BUSINESS</span>
            <h2>@(string.IsNullOrWhiteSpace(config.AboutTitle) ? $"About {Model.Business.Name}" : config.AboutTitle)</h2>
        </div>
        <p class="website-copy">@(string.IsNullOrWhiteSpace(config.AboutContent) ? Model.Business.Description : config.AboutContent)</p>
    </div>
</section>

@if (config.ShowWhyChooseUs && !string.IsNullOrWhiteSpace(config.WhyChooseUsContent))
{
    <section class="platform-section platform-soft">
        <div class="container">
            <div class="platform-section-head">
                <div><span class="platform-kicker dark">WHY US</span><h2>@config.WhyChooseUsTitle</h2></div>
                <p>Business-specific information managed by the business owner.</p>
            </div>
            <div class="website-text-card">
                <p class="website-copy">@config.WhyChooseUsContent</p>
            </div>
        </div>
    </section>
}

@if (config.ShowServices && !string.IsNullOrWhiteSpace(config.ServicesContent))
{
    <section class="platform-section" id="services">
        <div class="container">
            <div class="platform-section-head">
                <div><span class="platform-kicker dark">PRODUCTS &amp; SERVICES</span><h2>@config.ServicesTitle</h2></div>
                <p>Use this area for services, support, warranty, delivery or other useful customer information.</p>
            </div>
            <div class="website-text-card">
                <p class="website-copy">@config.ServicesContent</p>
            </div>
        </div>
    </section>
}

@if (Model.Brochures.Any())
{
    <section class="platform-section platform-soft" id="brochures">
        <div class="container">
            <div class="platform-section-head">
                <div><span class="platform-kicker dark">BROCHURES &amp; PDF CATALOG</span><h2>Property details &amp; brochures</h2></div>
                <p>View or download the business's brochures, property catalogues, rate cards or packages.</p>
            </div>
            <div class="feature-grid">
                @foreach (var brochure in Model.Brochures)
                {
                    <article class="offer-card">
                        <div style="font-size:36px">PDF</div>
                        <h3>@brochure.DisplayName</h3>
                        <p>PDF brochure · @((brochure.Length / 1024d / 1024d).ToString("0.0")) MB</p>
                        <a class="platform-btn platform-btn-primary" href="@brochure.RelativeUrl" target="_blank" rel="noopener">View brochure →</a>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (config.ShowOffers && Model.Offers.Any())
{
    <section class="platform-section platform-soft" id="offers">
        <div class="container">
            <div class="platform-section-head"><div><span class="platform-kicker dark">HOT DEALS</span><h2>Offers for you</h2></div></div>
            <div class="feature-grid">
                @foreach (var offer in Model.Offers)
                {
                    <article class="offer-card">
                        @if (!string.IsNullOrWhiteSpace(offer.ImageUrl)) { <img src="@offer.ImageUrl" alt="@offer.Title" /> }
                        <span class="offer-pill">@offer.DiscountText</span>
                        <h3>@offer.Title</h3>
                        <p>@offer.Description</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (config.ShowCatalog && Model.TopCatalog.Any())
{
    <section class="platform-section" id="catalog">
        <div class="container">
            <div class="platform-section-head">
                <div>
                    <span class="platform-kicker dark">TOP PICKS</span>
                    <h2>Featured products</h2>
                </div>
                <p>Products selected for WhatsApp are highlighted first here too.</p>
            </div>
            <div class="catalog-grid">
                @foreach (var item in Model.TopCatalog)
                {
                    <article class="catalog-card">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" /> }
                        <div class="product-details">
                            <span class="top-pick-badge">WhatsApp Top Pick</span>
                            <div class="product-meta">
                                @if (!string.IsNullOrWhiteSpace(item.Category)) { <span>@item.Category</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Brand)) { <span>• @item.Brand</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Model)) { <span>• @item.Model</span> }
                            </div>
                            <h3>@item.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.ShortDescription)) { <p>@item.ShortDescription</p> }
                            <div class="product-price">
                                <strong>@item.PriceText</strong>
                                @if (!string.IsNullOrWhiteSpace(item.OriginalPriceText)) { <del>@item.OriginalPriceText</del> }
                                @if (!string.IsNullOrWhiteSpace(item.DiscountText)) { <span class="product-discount">@item.DiscountText</span> }
                            </div>
                            @if (item.Rating.HasValue) { <div class="product-rating">★ @item.Rating.Value.ToString("0.0") @if (item.ReviewCount > 0) { <span>· @item.ReviewCount reviews</span> }</div> }
                            @if (!string.IsNullOrWhiteSpace(item.StockStatus)) { <span class="product-stock">@item.StockStatus</span> }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (config.ShowCatalog && remainingCatalog.Any())
{
    <section class="platform-section platform-soft">
        <div class="container">
            <div class="platform-section-head">
                <div><span class="platform-kicker dark">FULL CATALOG</span><h2>More products &amp; services</h2></div>
                <p>Customers can continue browsing the complete published website catalog.</p>
            </div>
            <div class="catalog-grid">
                @foreach (var item in remainingCatalog)
                {
                    <article class="catalog-card">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" /> }
                        <div class="product-details">
                            <div class="product-meta">
                                @if (!string.IsNullOrWhiteSpace(item.Category)) { <span>@item.Category</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Brand)) { <span>• @item.Brand</span> }
                                @if (!string.IsNullOrWhiteSpace(item.Model)) { <span>• @item.Model</span> }
                            </div>
                            <h3>@item.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.ShortDescription)) { <p>@item.ShortDescription</p> }
                            @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="website-copy">@item.Description</p> }
                            <div class="product-price">
                                <strong>@item.PriceText</strong>
                                @if (!string.IsNullOrWhiteSpace(item.OriginalPriceText)) { <del>@item.OriginalPriceText</del> }
                                @if (!string.IsNullOrWhiteSpace(item.DiscountText)) { <span class="product-discount">@item.DiscountText</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.StockStatus)) { <span class="product-stock">@item.StockStatus</span> }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (config.ShowCallToAction && !string.IsNullOrWhiteSpace(config.CallToActionText))
{
    <section class="platform-section">
        <div class="container">
            <div class="website-text-card" style="text-align:center">
                <span class="platform-kicker dark">GET STARTED</span>
                <h2>@config.CallToActionTitle</h2>
                <p class="website-copy">@config.CallToActionText</p>
                <a class="platform-btn platform-btn-primary" href="#enquiry">Contact @Model.Business.Name →</a>
            </div>
        </div>
    </section>
}

@if (config.ShowTestimonials && Model.Testimonials.Any())
{
    <section class="platform-section platform-soft">
        <div class="container">
            <div class="platform-section-head"><div><span class="platform-kicker dark">CUSTOMER FEEDBACK</span><h2>What customers say</h2></div><p>Only approved, published customer feedback is shown here.</p></div>
            <div class="testimonial-grid">
                @foreach (var item in Model.Testimonials)
                {
                    <article><span class="quote">“</span><p>@item.Feedback</p><strong>@item.CustomerName</strong><small>@item.Location</small></article>
                }
            </div>
        </div>
    </section>
}

<section class="platform-section" id="enquiry">
    <div class="container business-enquiry-grid">
        <div>
            <span class="platform-kicker dark">GET IN TOUCH</span>
            <h2>Contact @Model.Business.Name</h2>
            <p>@(string.IsNullOrWhiteSpace(config.ContactIntro) ? "Send an enquiry and the business team can follow up with you." : config.ContactIntro)</p>
            <p><strong>@Model.Business.PhoneNumber</strong><br />@Model.Business.Email<br />@Model.Business.Address, @Model.Business.City, @Model.Business.State - @Model.Business.PostalCode<br />@Model.Business.Country</p>
            @if (!string.IsNullOrWhiteSpace(Model.Business.BusinessHours))
            {
                <p class="website-copy"><strong>Business hours</strong><br />@Model.Business.BusinessHours</p>
            }
        </div>
        <div class="business-form">
            <form asp-controller="Business" asp-action="Enquiry" asp-route-slug="@Model.Business.Slug" method="post">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <div class="form-grid">
                    <div class="field"><label>Name</label><input name="Name" required /></div>
                    <div class="field"><label>Phone</label><input name="PhoneNumber" required /></div>
                    <div class="field full"><label>Email</label><input name="Email" type="email" /></div>
                    <div class="field full"><label>Message</label><textarea name="Message" rows="5" required></textarea></div>
                </div>
                <button class="platform-btn platform-btn-primary" type="submit">Send enquiry →</button>
            </form>
            @if (TempData["EnquirySuccess"] is not null) { <div class="success-banner">@TempData["EnquirySuccess"]</div> }
        </div>
    </div>
</section>
