@model List<BusinessFollowUp>
@{ var business=(Business)ViewBag.Business; ViewData["Title"]="Follow-ups"; Layout="_AdminLayout"; }
<section class="admin-page"><div class="container admin-wide">
<div class="admin-head"><div><span class="platform-kicker dark">CUSTOMER FOLLOW-UP</span><h1>@business.Name</h1><p>Track enquiries that need a next action. This is available for the WhatsApp + Business Enquiries + Follow-up mode.</p></div><div class="workspace-actions"><a class="workspace-btn workspace-btn-primary" asp-action="Create" asp-route-id="@business.Id">+ New follow-up</a><a class="workspace-btn workspace-btn-secondary" asp-controller="BusinessContent" asp-action="Index" asp-route-id="@business.Id">Catalog</a></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Customer</th><th>Phone</th><th>Status</th><th>Due</th><th>Notes</th><th>Action</th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="6">No follow-ups yet. Create one from an enquiry or manually.</td></tr>}
@foreach(var item in Model){<tr><td><strong>@item.CustomerName</strong></td><td>@item.CustomerPhoneNumber</td><td>@item.Status</td><td>@item.DueAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@item.Notes</td><td>@if(item.Status!=FollowUpStatuses.Completed){<form asp-action="Complete" method="post" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><button class="workspace-btn workspace-btn-secondary" type="submit">Complete</button></form>}</td></tr>}
</tbody></table></div></div></section>
