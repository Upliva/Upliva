@model BusinessFollowUp
@{ var business=(Business)ViewBag.Business; ViewData["Title"]="Create Follow-up"; Layout="_AdminLayout"; }
<section class="admin-page"><div class="container admin-narrow"><div class="admin-head"><div><span class="platform-kicker dark">FOLLOW-UP</span><h1>New follow-up</h1><p>Create a next action for a customer enquiry.</p></div><a class="workspace-btn workspace-btn-secondary" asp-action="Index" asp-route-id="@business.Id">← Back</a></div>
<form asp-action="Create" method="post" class="business-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="BusinessId"/><input type="hidden" asp-for="EnquiryId"/><input type="hidden" asp-for="CatalogItemId"/><div class="form-grid"><div class="field"><label asp-for="CustomerName"></label><input asp-for="CustomerName"/><span asp-validation-for="CustomerName" class="validation"></span></div><div class="field"><label asp-for="CustomerPhoneNumber"></label><input asp-for="CustomerPhoneNumber"/><span asp-validation-for="CustomerPhoneNumber" class="validation"></span></div><div class="field full"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="5"></textarea></div><div class="field"><label asp-for="Status"></label><select asp-for="Status">@foreach(var status in FollowUpStatuses.All){<option value="@status">@status</option>}</select></div><div class="field"><label asp-for="DueAtUtc"></label><input asp-for="DueAtUtc" type="datetime-local"/></div></div><button class="platform-btn platform-btn-primary" type="submit">Create follow-up</button></form></div></section>
