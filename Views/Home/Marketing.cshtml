@{
    ViewData["Title"] = "WhatsApp Growth for Local Businesses";
    Layout = "_MarketingLayout";
}

<div class="upliva-loader" id="platformLoader" aria-hidden="true">
    <img class="upliva-loader-logo" src="@Url.Content("~/images/upliva/upliva-logo.svg")" alt="UplivaAI" />
    <span>Business growth on WhatsApp</span>
</div>

<section class="upliva-slide upliva-hero" id="why">
    <div class="upliva-hero-glow upliva-glow-one"></div>
    <div class="upliva-hero-glow upliva-glow-two"></div>
    <div class="container upliva-hero-grid">
        <div class="upliva-hero-copy">
            <div class="upliva-eyebrow"><span></span> BUILT FOR THE AI ERA OF LOCAL BUSINESS</div>
            <h1>Stop losing customers in <em>everyday WhatsApp chats.</em></h1>
            <h2>Your customers are already there. <strong>Now make every message count.</strong></h2>
            <p class="upliva-hero-sub">UplivaAI gives your business a professional website, WhatsApp-led enquiries and AI-assisted productivity — without asking your customers to download another app.</p>
            <div class="upliva-hero-actions">
                <a class="upliva-btn upliva-btn-primary" href="/register">Get more leads on WhatsApp <span>↗</span></a>
                <a class="upliva-btn upliva-btn-secondary" href="#how-it-works">See how it works ↓</a>
            </div>
            <div class="upliva-trust-row">
                <span>✓ Website included</span>
                <span>✓ WhatsApp-first</span>
                <span>✓ No customer app</span>
                <span>✓ AI-ready</span>
                <span>✓ India · Sri Lanka · USA</span>
            </div>
        </div>

        <div class="upliva-hero-visual">
            <div class="upliva-video-shell">
                <div class="video-topline"><span class="live-dot"></span><span>15-second growth story</span><span class="video-sound">🔊 Music included</span></div>
                <video class="upliva-ad-video" controls playsinline preload="metadata" poster="@Url.Content("~/images/upliva/video-scene-1.png")">
                    <source src="@Url.Content("~/videos/uplivaai-15s-ad.mp4")" type="video/mp4" />
                    Your browser does not support video playback.
                </video>
                <div class="video-bottomline"><span>Missed chat → smart follow-up → new opportunity</span><span>Play with sound</span></div>
            </div>
            <div class="upliva-floating-card lead-card"><span class="floating-label">NEW LEAD</span><strong>Customer asked for a price</strong><small>Reply while the interest is still hot.</small></div>
            <div class="upliva-growth-stamp">CHAT <b>→</b> LEAD <b>→</b> GROWTH</div>
        </div>
    </div>
</section>

<section class="upliva-slide upliva-offer upliva-combined" id="how-it-works">
    <div class="container">
        <div class="upliva-section-heading center compact-heading">
            <span class="upliva-kicker">HOW IT WORKS · WHAT YOU GET</span>
            <h2>One simple journey from <em>WhatsApp chat</em> to business opportunity.</h2>
            <p>UplivaAI connects the tools your business needs without asking customers to learn a new app.</p>
        </div>

        <div class="upliva-journey-grid">
            <article class="journey-card journey-step">
                <div class="journey-top"><span>01</span><div class="journey-icon">💬</div></div>
                <h3>Customers message you</h3>
                <p>Questions, product requests, price enquiries and offers start naturally on WhatsApp.</p>
                <div class="journey-output"><strong>Customer experience</strong><span>Familiar WhatsApp conversation</span></div>
            </article>
            <article class="journey-card journey-step">
                <div class="journey-top"><span>02</span><div class="journey-icon">⚡</div></div>
                <h3>Your business responds smarter</h3>
                <p>Share your products, services, offers and website from one business setup.</p>
                <div class="journey-output"><strong>You get</strong><span>WhatsApp-led enquiries + product showcase</span></div>
            </article>
            <article class="journey-card journey-step">
                <div class="journey-top"><span>03</span><div class="journey-icon">🌐</div></div>
                <h3>Your website does the deeper work</h3>
                <p>Customers can explore your complete catalog, services, hot deals and business details.</p>
                <div class="journey-output"><strong>You get</strong><span>Professional website + full catalog</span></div>
            </article>
            <article class="journey-card journey-step journey-highlight">
                <div class="journey-top"><span>04</span><div class="journey-icon">📈</div></div>
                <h3>Interest becomes an opportunity</h3>
                <p>Capture enquiries and use AI-assisted productivity tools to help your team follow up.</p>
                <div class="journey-output"><strong>You get</strong><span>Enquiries + offers + AI-assisted productivity</span></div>
            </article>
        </div>

        <div id="what-you-get" class="upliva-get-strip">
            <div class="get-strip-title"><span class="upliva-kicker">YOUR UPLIVAAI TOOLKIT</span><h3>Everything important, in one place.</h3></div>
            <div class="get-strip-items">
                <span><b>WhatsApp</b> customer conversations</span>
                <span><b>Website</b> business presence</span>
                <span><b>Catalog</b> products & services</span>
                <span><b>Hot Deals</b> timely offers</span>
                <span><b>AI</b> productivity assistance</span>
            </div>
        </div>

        <div class="upliva-business-problem">
            <div class="problem-copy"><span class="upliva-kicker">THE EVERYDAY PROBLEM</span><h3>“I'll reply later” is where many opportunities disappear.</h3><p>While you're serving customers, driving deliveries or running the shop, WhatsApp messages keep arriving. UplivaAI puts a simple business process around those conversations.</p></div>
            <div class="problem-flow"><div><b>Customer asks</b><small>“Price?”</small></div><span>→</span><div><b>Message gets buried</b><small>Too many chats</small></div><span>→</span><div class="problem-final"><b>UplivaAI</b><small>Turn interest into a clearer next step</small></div></div>
        </div>

        <div class="upliva-proof-band">
            <div><strong>Serving businesses in 3 markets</strong><span>India · Sri Lanka · USA</span></div>
            <div><strong>Built for growing businesses</strong><span>Retail · Grocery · Furniture · Salon · Restaurant · Services</span></div>
            <div><strong>Start simple. Grow smarter.</strong><span>WhatsApp, website and AI-assisted productivity in one practical platform.</span></div>
        </div>

        <div class="upliva-testimonials">
            <div class="testimonial-heading"><span class="upliva-kicker">CUSTOMER VOICES</span><h3>More conversations. Less chasing.</h3><p>Representative voices for the marketing prototype. Replace these with verified customer feedback and approved names as customers onboard.</p></div>
            <div class="testimonial-list">
                <article><div class="quote-mark">“</div><p>“Our customers already use WhatsApp. UplivaAI helps us turn those everyday questions into clearer sales opportunities.”</p><span>Illustrative · Retail business owner</span></article>
                <article><div class="quote-mark">“</div><p>“I do not want customers to download another app. I want them to message us, see what we offer and enquire quickly.”</p><span>Illustrative · Service business owner</span></article>
                <article><div class="quote-mark">“</div><p>“The website builds trust, WhatsApp starts the conversation and AI-assisted follow-up helps us stay productive.”</p><span>Illustrative · Local business owner</span></article>
            </div>
        </div>

        <div class="upliva-pricing-section" id="pricing">
            <div class="upliva-section-heading center compact-heading">
                <span class="upliva-kicker">PRICING</span>
                <h2>Simple plans. Clear value.</h2>
                <p>Choose a starting point and grow as your business needs more from WhatsApp and the web.</p>
            </div>
            <div class="upliva-pricing-grid">
                <article class="upliva-price-card">
                    <span class="price-label">START</span>
                    <h3>₹699</h3><small>/ starting</small>
                    <p>For businesses getting their digital presence started.</p>
                    <ul><li>Business website</li><li>WhatsApp enquiry setup</li><li>Basic business showcase</li></ul>
                    <a href="/register" class="upliva-btn upliva-btn-secondary full">Get Started <span>↗</span></a>
                </article>
                <article class="upliva-price-card featured">
                    <span class="price-label">GROW</span><span class="price-popular">POPULAR</span>
                    <h3>₹999</h3><small>/ starting</small>
                    <p>A practical package for businesses ready to showcase products and offers.</p>
                    <ul><li>Everything in Start</li><li>Catalog & featured products</li><li>Hot deals showcase</li></ul>
                    <a href="/register" class="upliva-btn upliva-btn-primary full">Register your business <span>↗</span></a>
                </article>
                <article class="upliva-price-card">
                    <span class="price-label">SCALE</span>
                    <h3>₹1,999</h3><small>/ starting</small>
                    <p>For businesses that want a richer customer and WhatsApp experience.</p>
                    <ul><li>Everything in Grow</li><li>Advanced business showcase</li><li>AI-assisted productivity features</li></ul>
                    <a href="/register" class="upliva-btn upliva-btn-secondary full">Get Started <span>↗</span></a>
                </article>
            </div>
            <div class="pricing-note">Plans and onboarding scope can vary by business. WhatsApp/Meta charges, where applicable, are separate.</div>
        </div>

        <div class="upliva-register-panel">
            <div><span class="upliva-kicker">READY WHEN YOU ARE</span><h2>Make WhatsApp the front door to your business.</h2><p>Register your business. Our admin team reviews the details, configures your business page and publishes it when ready.</p></div>
            <div class="upliva-register-card"><span class="register-badge">SERVING INDIA · SRI LANKA · USA</span><h3>Ready to turn chats into opportunities?</h3><div class="register-types"><span>Retail</span><span>Grocery</span><span>Hardware</span><span>Furniture</span><span>Salon</span><span>Restaurant</span><span>Services</span></div><a class="upliva-btn upliva-btn-primary full" href="/register">Register your business <span>↗</span></a><div class="register-login">Already registered? <a asp-route="UplivaLogin">Login here</a></div></div>
        </div>
    </div>
</section>
