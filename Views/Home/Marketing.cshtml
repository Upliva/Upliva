@{
    ViewData["Title"] = "WhatsApp-first business platform";
    Layout = "_MarketingLayout";
}

<section class="upliva-slide upliva-hero" id="why">
    <div class="upliva-hero-glow upliva-glow-one"></div>
    <div class="upliva-hero-glow upliva-glow-two"></div>
    <div class="container upliva-hero-grid">
        <div class="upliva-hero-copy">
            <div class="upliva-eyebrow"><span></span> WHATSAPP-FIRST BUSINESS PLATFORM</div>
            <h1>Turn customer chats into <em>catalog, enquiries and follow-up.</em></h1>
            <p class="upliva-hero-sub">UplivaAI gives local businesses one practical workflow: show products or services on WhatsApp, capture customer interest and keep the next action visible.</p>
            <div class="upliva-hero-actions">
                <a class="upliva-btn upliva-btn-primary" href="/register">Register your business <span>↗</span></a>
                <a class="upliva-btn upliva-btn-secondary" href="#use-cases">See real use cases ↓</a>
            </div>
            <div class="upliva-trust-row">
                <span>✓ WhatsApp-first</span><span>✓ Dynamic catalog</span><span>✓ No customer app</span><span>✓ Follow-up ready</span>
            </div>
        </div>
        <div class="upliva-hero-visual">
            <div class="upliva-video-shell">
                <div class="video-topline"><span class="live-dot"></span><span>UplivaAI workflow</span><span class="video-sound">Catalog → Enquiry → Follow-up</span></div>
                <video class="upliva-ad-video" controls playsinline preload="metadata" poster="@Url.Content("~/images/upliva/video-scene-1.png")">
                    <source src="@Url.Content("~/videos/uplivaai-15s-ad.mp4")" type="video/mp4" />
                </video>
                <div class="video-bottomline"><span>One catalog. Multiple business use cases.</span><span>Play</span></div>
            </div>
        </div>
    </div>
</section>

<section class="upliva-slide upliva-offer upliva-combined" id="use-cases">
    <div class="container">
        <div class="upliva-section-heading center compact-heading">
            <span class="upliva-kicker">BUILT AROUND REAL BUSINESS WORK</span>
            <h2>One platform. Different businesses. Same simple flow.</h2>
            <p>Your team maintains the catalog once. The same business data powers the WhatsApp showcase and enquiry workflow.</p>
        </div>
        <div class="upliva-journey-grid">
            <article class="journey-card journey-step"><div class="journey-top"><span>01</span><div class="journey-icon">🏠</div></div><h3>Real Estate</h3><p>Property name, price, BHK, area, location, images and other optional property details.</p><div class="journey-output"><strong>Customer asks</strong><span>“Send me the 3 BHK details.”</span></div></article>
            <article class="journey-card journey-step"><div class="journey-top"><span>02</span><div class="journey-icon">🏨</div></div><h3>Hotel & Resort</h3><p>Rooms, rates, occupancy, amenities and images can be maintained as catalog items.</p><div class="journey-output"><strong>Customer asks</strong><span>“Do you have a room for tomorrow?”</span></div></article>
            <article class="journey-card journey-step"><div class="journey-top"><span>03</span><div class="journey-icon">🛋️</div></div><h3>Retail & Furniture</h3><p>Products, prices, stock, images, offers and business-specific fields stay in one master catalog.</p><div class="journey-output"><strong>Customer asks</strong><span>“Price and availability?”</span></div></article>
            <article class="journey-card journey-step journey-highlight"><div class="journey-top"><span>04</span><div class="journey-icon">📋</div></div><h3>Services & Enquiries</h3><p>Capture the enquiry, connect it to the business and create the next follow-up action.</p><div class="journey-output"><strong>Team gets</strong><span>Customer → enquiry → follow-up</span></div></article>
        </div>
        <div class="upliva-get-strip">
            <div class="get-strip-title"><span class="upliva-kicker">CORE WORKSPACE</span><h3>Simple by design.</h3></div>
            <div class="get-strip-items"><span><b>Business</b> profile</span><span><b>Catalog</b> products & services</span><span><b>WhatsApp</b> showcase</span><span><b>Enquiries</b> customer interest</span><span><b>Follow-up</b> next actions</span></div>
        </div>
    </div>
</section>

<section class="upliva-slide upliva-offer upliva-combined" id="plans">
    <div class="container">
        <div class="upliva-section-heading center compact-heading">
            <span class="upliva-kicker">CHOOSE YOUR WORKFLOW</span>
            <h2>Start with the communication your business needs.</h2>
            <p>No lengthy setup on day one. Register with whatever information you already have and complete the profile and catalog later.</p>
        </div>
        <div class="upliva-pricing-grid" style="grid-template-columns:repeat(2,1fr)">
            <article class="upliva-price-card"><span class="price-label">MODE 01</span><h3>WhatsApp + SMS</h3><p>For businesses that want a WhatsApp-led catalog and communication workflow.</p><ul><li>Business profile</li><li>Dynamic catalog</li><li>WhatsApp product showcase</li><li>SMS-ready workflow</li></ul><a href="/register" class="upliva-btn upliva-btn-secondary full">Get started <span>↗</span></a></article>
            <article class="upliva-price-card featured"><span class="price-label">MODE 02</span><span class="price-popular">ENQUIRY WORKFLOW</span><h3>WhatsApp + Enquiries + Follow-up</h3><p>For businesses that want to turn customer conversations into trackable opportunities.</p><ul><li>Everything in Mode 01</li><li>Business enquiries</li><li>Follow-up tracking</li><li>Operational workspace</li></ul><a href="/register" class="upliva-btn upliva-btn-primary full">Register your business <span>↗</span></a></article>
        </div>
        <div class="upliva-register-panel" style="margin-top:34px">
            <div><span class="upliva-kicker">READY TO TEST</span><h2>Start with the data you have today.</h2><p>Register with your business name, business type and WhatsApp number. Catalog Product Name is the only required catalog field; all other catalog fields are optional.</p></div>
            <div class="upliva-register-card"><span class="register-badge">WHATSAPP · CATALOG · ENQUIRY</span><h3>Let's set up your business</h3><div class="register-types"><span>Real Estate</span><span>Hotel</span><span>Furniture</span><span>Retail</span><span>Grocery</span><span>Services</span></div><a class="upliva-btn upliva-btn-primary full" href="/register">Register now <span>↗</span></a><div class="register-login">Already registered? <a asp-route="UplivaLogin">Login here</a></div></div>
        </div>
    </div>
</section>

<button type="button" class="upliva-chatbot-launch" id="uplivaChatbotLaunch" aria-label="Talk to Upliva Platform"><span class="upliva-chatbot-dot"></span> Let's talk</button>
<div class="upliva-chatbot" id="uplivaMarketingChatbot" aria-hidden="true">
    <div class="upliva-chatbot-card">
        <div class="upliva-chatbot-head"><div><span class="upliva-kicker">UPLIVA PLATFORM</span><strong>Tell us about your business</strong></div><div class="upliva-chatbot-head-actions"><button type="button" id="uplivaChatbotVoice" aria-label="Turn voice prompts on or off">🔊</button><button type="button" id="uplivaChatbotClose" aria-label="Close">×</button></div></div>
        <div class="upliva-chatbot-body">
            <div class="upliva-chatbot-message">Johar Jharkhand! 👋 Enter your business name, business type and WhatsApp number to get started.</div>
            <form id="uplivaLeadForm" class="upliva-chatbot-form" novalidate>
                @Html.AntiForgeryToken()
                <label data-chat-step="1">Business name <span>(required)</span><input name="Name" maxlength="180" autocomplete="organization" placeholder="HarHarMahadev" /></label>
                <label data-chat-step="2" hidden>Business type <span>(required)</span><select name="BusinessType"><option value="">Select business type</option>@foreach (var type in BusinessTypeOptions.All){<option value="@type">@type</option>}</select></label>
                <label data-chat-step="3" hidden>WhatsApp / mobile <span>(required)</span><input name="WhatsAppNumber" maxlength="10" inputmode="numeric" autocomplete="tel" pattern="[6-9][0-9]{9}" placeholder="9876543210" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10)" /></label>
                <button type="button" class="upliva-chatbot-next" id="uplivaLeadNext">Continue</button>
            </form>
            <div class="upliva-chatbot-progress" id="uplivaLeadProgress">Question 1 of 3</div>
            <div class="upliva-chatbot-result" id="uplivaLeadResult" hidden></div>
        </div>
    </div>
</div>
<script>
(function(){
 const launch=document.getElementById('uplivaChatbotLaunch'), chat=document.getElementById('uplivaMarketingChatbot'), close=document.getElementById('uplivaChatbotClose'), voiceButton=document.getElementById('uplivaChatbotVoice'), form=document.getElementById('uplivaLeadForm'), progress=document.getElementById('uplivaLeadProgress'), result=document.getElementById('uplivaLeadResult'), next=document.getElementById('uplivaLeadNext');
 if(!launch||!chat||!form)return;
 const steps=[...form.querySelectorAll('[data-chat-step]')]; const voiceSupported='speechSynthesis' in window && 'SpeechSynthesisUtterance' in window; let current=0; let voiceEnabled=voiceSupported;
 const prompts=['Johar Jharkhand! Welcome to Upliva. Enter your business details to get started.','Please enter your business name.','Select your business type.','Enter your WhatsApp number.','Your business details were received successfully. Our business team will follow up shortly.'];
 function speak(text){if(!voiceEnabled||!voiceSupported)return;window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='en-IN';u.rate=.95;window.speechSynthesis.speak(u);}
 function resetChat(){current=0;form.reset();steps.forEach((x,n)=>x.hidden=n!==0);progress.hidden=false;progress.textContent='Question 1 of 3';result.hidden=true;result.textContent='';result.className='upliva-chatbot-result';next.disabled=false;next.textContent='Continue';}
 function open(){resetChat();chat.classList.add('is-open');chat.setAttribute('aria-hidden','false');speak(prompts[0]);setTimeout(()=>steps[0].querySelector('input,select')?.focus(),100);}
 function hide(){chat.classList.remove('is-open');chat.setAttribute('aria-hidden','true');if(voiceSupported)window.speechSynthesis.cancel();}
 function showStep(i){steps.forEach((x,n)=>x.hidden=n!==i);progress.textContent=`Question ${i+1} of 3`;next.textContent=i===2?'Send details':'Continue';speak(prompts[i+1]);steps[i].querySelector('input,select')?.focus();}
 launch.addEventListener('click',open);close?.addEventListener('click',hide);
 voiceButton?.addEventListener('click',()=>{voiceEnabled=!voiceEnabled;voiceButton.textContent=voiceEnabled?'🔊':'🔇';if(voiceEnabled)speak(prompts[current+1]||prompts[0]);else if(voiceSupported)window.speechSynthesis.cancel();});
 next.addEventListener('click',async()=>{
   const field=steps[current].querySelector('input,select'); if(!field)return; const value=(field.value||'').trim();
   if(!value){field.setCustomValidity('This field is required.');field.reportValidity();field.setCustomValidity('');return;}
   if(current===0 && value.length>150){field.setCustomValidity('Please enter a shorter name.');field.reportValidity();field.setCustomValidity('');return;}
   if(current===2 && value){const digits=value.replace(/\D/g,'');if(!/^[6-9]\d{9}$/.test(digits)){field.setCustomValidity('If you provide WhatsApp, enter a valid 10-digit Indian number.');field.reportValidity();field.setCustomValidity('');return;}}
   if(current<2){current++;showStep(current);return;}
   next.disabled=true;next.textContent='Sending...';result.hidden=true;
   const controller=new AbortController();const timeoutId=setTimeout(()=>controller.abort(),15000);
   try{const fd=new FormData(form);const token=form.querySelector('input[name="__RequestVerificationToken"]')?.value;const headers={'X-Requested-With':'XMLHttpRequest','Accept':'application/json'};if(token)headers['RequestVerificationToken']=token;const res=await fetch('/marketing/chatbot/lead',{method:'POST',body:fd,headers,signal:controller.signal});const data=await res.json().catch(()=>({success:false,message:'Unexpected server response.'}));if(!res.ok||!data.success)throw new Error(data.message||'We could not save your details. Please try again.');steps.forEach(x=>x.hidden=true);progress.hidden=true;next.textContent='Submitted ✓';result.hidden=false;result.className='upliva-chatbot-result success';result.textContent=data.message||prompts[4];speak(prompts[4]);}catch(err){result.hidden=false;result.className='upliva-chatbot-result error';result.textContent=err?.name==='AbortError'?'The request took too long. Please try again.':(err?.message||'We could not save your details. Please try again.');next.disabled=false;next.textContent='Send details';}finally{clearTimeout(timeoutId);}
 });
})();
</script>
