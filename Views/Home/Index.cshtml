@{
    ViewData["Title"] = "Luxury Resort Booking";
    var resort = (ResortInfo)ViewBag.Resort;
    var rooms = (List<Room>)ViewBag.Rooms;
    var packages = (List<Package>)ViewBag.Packages;
}

<section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <span class="eyebrow">WELCOME TO PARADISE</span>
        <h1>A stay worth<br /><em>remembering.</em></h1>
        <p>@resort.Description</p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Check availability <span>→</span></a>
            <a class="btn btn-light" asp-controller="Rooms" asp-action="Index">Explore rooms</a>
        </div>
    </div>
    <div class="booking-bar">
        <form asp-controller="Booking" asp-action="Index" method="get" class="container quick-search">
            <div>
                <label>CHECK-IN</label>
                <input type="date" name="checkIn" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label>CHECK-OUT</label>
                <input type="date" name="checkOut" value="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label>GUESTS</label>
                <select name="guests">
                    <option value="1">1 Guest</option>
                    <option value="2" selected>2 Guests</option>
                    <option value="3">3 Guests</option>
                    <option value="4">4 Guests</option>
                    <option value="5">5 Guests</option>
                </select>
            </div>
            <button class="btn btn-dark" type="submit">Check rooms</button>
        </form>
    </div>
</section>

<section class="section intro">
    <div class="container two-col">
        <div>
            <span class="eyebrow dark">YOUR PRIVATE ESCAPE</span>
            <h2>Relax. Reconnect.<br />Enjoy every moment.</h2>
        </div>
        <div class="intro-copy">
            <p>From slow mornings to sunset dinners, Paradise Palm is designed around simple comforts and beautiful experiences.</p>
            <a class="text-link" asp-controller="Packages" asp-action="Index">Discover our packages →</a>
        </div>
    </div>
</section>

<section class="section soft-bg">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow dark">STAY WITH US</span>
                <h2>Rooms & suites</h2>
            </div>
            <a class="text-link" asp-controller="Rooms" asp-action="Index">View all rooms →</a>
        </div>
        <div class="cards-3">
            @foreach (var room in rooms)
            {
                <article class="room-card">
                    <div class="card-image" style="background-image:url('@room.ImageUrl')"></div>
                    <div class="card-body">
                        <div class="card-meta"><span>Up to @room.MaxGuests guests</span><strong>₹@room.PricePerNight.ToString("N0") / night</strong></div>
                        <h3>@room.Name</h3>
                        <p>@room.Description</p>
                        <a asp-controller="Booking" asp-action="Index" class="text-link">Book this room →</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow dark">SPECIAL OFFERS</span>
                <h2>Packages made for you</h2>
            </div>
            <a class="text-link" asp-controller="Packages" asp-action="Index">View packages →</a>
        </div>
        <div class="cards-3">
            @foreach (var package in packages)
            {
                <article class="package-card">
                    <div class="package-image" style="background-image:url('@package.ImageUrl')"></div>
                    <div class="card-body">
                        <span class="pill">@package.DurationNights nights</span>
                        <h3>@package.Name</h3>
                        <p>@package.Description</p>
                        <div class="package-price">₹@package.Price.ToString("N0")</div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="cta">
    <div class="container cta-inner">
        <div>
            <span class="eyebrow">READY WHEN YOU ARE</span>
            <h2>Your next getaway starts here.</h2>
        </div>
        <a class="btn btn-light" asp-controller="Booking" asp-action="Index">Book your stay →</a>
    </div>
</section>
