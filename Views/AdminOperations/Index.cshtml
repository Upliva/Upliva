@model IReadOnlyList<UplivaAI.Models.IntegrationLog>
@{ ViewData["Title"] = "Integration Logs"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container">
<div class="admin-head"><div><span class="platform-kicker dark">OPERATIONS</span><h1>Integration logs</h1><p>Azure, email and future Gupshup operations are traceable by correlation ID and business.</p></div><div class="workspace-page-actions"><a class="workspace-btn workspace-btn-secondary" asp-action="Notifications">Notification logs</a><a class="workspace-btn workspace-btn-secondary" asp-controller="AdminErrorLogs" asp-action="Index">Error logs</a></div></div>
<form method="get" class="business-form ws-mb-24"><div class="form-grid"><div class="field"><label>Correlation ID</label><input name="correlationId" value="@ViewBag.CorrelationId" /></div><div class="field"><label>Business ID</label><input name="businessId" type="number" value="@ViewBag.BusinessId" /></div><div class="field"><label>Integration</label><input name="integration" value="@ViewBag.Integration" placeholder="AzureBlob / Email / Gupshup" /></div></div><button class="platform-btn platform-btn-primary" type="submit">Search</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Time</th><th>Integration</th><th>Operation</th><th>Status</th><th>Business</th><th>Duration</th><th>Correlation</th><th>Error</th></tr></thead><tbody>
@foreach(var log in Model){<tr><td>@log.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@log.IntegrationName</td><td>@log.Operation</td><td>@log.Status</td><td>@(log.BusinessId?.ToString() ?? "-")</td><td>@log.DurationMs ms</td><td><code>@log.CorrelationId</code></td><td>@log.ErrorMessage</td></tr>}
@if(Model.Count == 0){<tr><td colspan="8">No integration logs found.</td></tr>}
</tbody></table></div></div></section>
