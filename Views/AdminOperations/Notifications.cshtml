@model IReadOnlyList<UplivaAI.Models.NotificationLog>
@{ ViewData["Title"] = "Notification Logs"; Layout = "_AdminLayout"; }
<section class="admin-page"><div class="container">
<div class="admin-head"><div><span class="platform-kicker dark">NOTIFICATIONS</span><h1>Notification logs</h1><p>Enquiries are stored before email notification. Failed emails remain retryable and never delete the lead.</p></div></div>
<form method="get" class="business-form ws-mb-24"><div class="form-grid"><div class="field"><label>Correlation ID</label><input name="correlationId" value="@ViewBag.CorrelationId" /></div><div class="field"><label>Business ID</label><input name="businessId" type="number" value="@ViewBag.BusinessId" /></div><div class="field"><label>Status</label><select name="status"><option value="">All</option><option value="Pending">Pending</option><option value="Sent">Sent</option><option value="Failed">Failed</option></select></div></div><button class="platform-btn platform-btn-primary" type="submit">Search</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Time</th><th>Channel</th><th>Recipient</th><th>Status</th><th>Attempts</th><th>Next Attempt</th><th>Correlation</th><th>Error</th></tr></thead><tbody>
@foreach(var log in Model){<tr><td>@log.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@log.Channel</td><td>@log.Recipient</td><td>@log.Status</td><td>@log.Attempts</td><td>@(log.NextAttemptAtUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "-")</td><td><code>@log.CorrelationId</code></td><td>@log.LastError</td></tr>}
@if(Model.Count == 0){<tr><td colspan="8">No notification logs found.</td></tr>}
</tbody></table></div></div></section>
