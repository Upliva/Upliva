@{ ViewData["Title"] = "Information received"; Layout = "_MarketingLayout"; }
<section class="confirmation platform-confirmation">
    <div class="confirmation-card lead-success-card">
        <div class="success-icon">✓</div>
        <span class="platform-kicker dark">THANK YOU</span>
        <h1>Your information was received successfully.</h1>
        <p>Our business team will reach out to you within <strong>24 hours</strong> to understand your requirements and next steps.</p>
        <p>Need support or assistance? You can connect with us 24×7 at <strong>uplivasupport@gmail.com</strong>.</p>
        <div class="lead-success-note"><strong>What happens next?</strong><span>After you confirm with our team, we will create your business profile and collect the catalog, images, PDF brochure and website details you want to showcase.</span></div>
        <div class="confirmation-actions">
            <a class="platform-btn platform-btn-primary" asp-controller="Home" asp-action="Index">Back to Upliva</a>
        </div>
    </div>
</section>
