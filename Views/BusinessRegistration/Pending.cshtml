@model Business
@{ ViewData["Title"] = "Registration submitted"; Layout = "_MarketingLayout"; }
<section class="confirmation platform-confirmation"><div class="confirmation-card"><div class="success-icon">✓</div><span class="platform-kicker dark">REGISTRATION RECEIVED</span><h1>@Model.Name</h1><p>Your business registration has been submitted successfully. Current status: <strong>@Model.Status</strong>.</p><p>An authorized UplivaAI administrator must approve and publish your business before the owner account can access the live business dashboard.</p><div class="confirmation-actions"><a class="platform-btn platform-btn-primary" href="/login">Business login</a><a class="platform-btn platform-btn-ghost" asp-controller="Home" asp-action="Index">Back to UplivaAI</a></div></div></section>
