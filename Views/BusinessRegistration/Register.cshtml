@model UplivaAI.Models.LeadRegistrationViewModel
@{ ViewData["Title"] = "Grow your business with Upliva"; Layout = "_MarketingLayout"; }

<section class="platform-section platform-soft">
    <div class="container registration-grid registration-lead-only">
        <div class="registration-info">
            <span class="platform-kicker dark">START WITH UPLIVA</span>
            <h2>Let's grow your business.</h2>
            <p class="registration-lead-copy">Share just three details. There is no password, catalog or lengthy business form at this stage.</p>
            <div class="registration-steps">
                <div><span>01</span><strong>Tell us about you</strong><small>Name, business category and WhatsApp / phone.</small></div>
                <div><span>02</span><strong>Our team connects</strong><small>We will contact you within 24 hours to understand your needs.</small></div>
                <div><span>03</span><strong>Complete onboarding later</strong><small>After confirmation, we collect your catalog, images, PDF and website details.</small></div>
            </div>
        </div>

        <div class="business-form lead-registration-card">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation" role="alert">
                    <strong>Please check the details below.</strong>
                    <ul style="margin:6px 0 0 18px;padding:0;">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Where(e => !string.IsNullOrWhiteSpace(e.ErrorMessage)))
                        { <li>@error.ErrorMessage</li> }
                    </ul>
                </div>
            }

            <div class="lead-form-heading">
                <span class="platform-kicker dark">BUSINESS ENQUIRY</span>
                <h3>Tell us how we can help</h3>
                <p>Share three details and we will save your enquiry. No account, password or business profile is created at this stage.</p>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="lead-form-fields">
                    <div class="field full">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" placeholder="Rahul Sharma" autocomplete="name" autofocus />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="field full">
                        <label asp-for="BusinessType"></label>
                        <select asp-for="BusinessType">
                            <option value="">Select your business category</option>
                            @foreach (var businessType in BusinessTypeOptions.All)
                            { <option value="@businessType">@businessType</option> }
                        </select>
                        <span asp-validation-for="BusinessType"></span>
                    </div>
                    <div class="field full">
                        <label asp-for="WhatsAppNumber"></label>
                        <input asp-for="WhatsAppNumber" placeholder="9876543210" maxlength="10" autocomplete="tel" inputmode="numeric" pattern="[6-9][0-9]{9}" oninput="this.value=this.value.replace(/\D/g,'').slice(0,10)" />
                        <span class="field-hint">Enter 10 digits only. Example: 9876543210. We will add +91 automatically.</span>
                        <span asp-validation-for="WhatsAppNumber"></span>
                    </div>
                </div>

                <button class="platform-btn platform-btn-primary full lead-submit-btn" type="submit">Send my details <span>→</span></button>
                <p class="lead-privacy-note">No account is created at this stage. Your details are used to help our business team follow up with you.</p>
            </form>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
