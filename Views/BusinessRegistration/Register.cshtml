@model BusinessRegistrationViewModel
@{ ViewData["Title"] = "Register your business"; Layout = "_MarketingLayout"; }
<section class="platform-page-hero"><div class="container"><span class="platform-kicker">BUSINESS REGISTRATION</span><h1>Tell us about your business.</h1><p>Choose your business type and submit your details. An UplivaAI administrator will review the registration before the website is approved and published.</p></div></section>
<section class="platform-section platform-soft"><div class="container registration-grid"><div class="registration-info"><span class="platform-kicker dark">WHAT HAPPENS NEXT</span><h2>Approval before publishing.</h2><ol><li><strong>Register</strong><span>Submit business and owner details.</span></li><li><strong>Admin review</strong><span>Our authorized admin verifies the submission.</span></li><li><strong>Configure</strong><span>Approved owners can manage permitted content.</span></li><li><strong>Publish</strong><span>Only admin can publish the public website.</span></li></ol></div><div class="business-form"><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field full"><label asp-for="BusinessName"></label><input asp-for="BusinessName" placeholder="ABC Grocery" /><span asp-validation-for="BusinessName"></span></div><div class="field"><label asp-for="BusinessType"></label><select asp-for="BusinessType"><option value="">Select business type</option><option>Retail</option><option>Grocery</option><option>Hardware</option><option>Furniture</option><option>Salon</option><option>Restaurant</option><option>Resort / Hotel</option><option>Pathology / Diagnostic</option><option>School / Education</option><option>Transportation</option><option>Other</option></select><span asp-validation-for="BusinessType"></span></div><div class="field"><label asp-for="OwnerName"></label><input asp-for="OwnerName" /><span asp-validation-for="OwnerName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" /><span asp-validation-for="PhoneNumber"></span></div><div class="field"><label asp-for="WhatsAppNumber"></label><input asp-for="WhatsAppNumber" placeholder="919XXXXXXXXX" /><span asp-validation-for="WhatsAppNumber"></span></div><div class="field"><label asp-for="City"></label><input asp-for="City" /></div><div class="field"><label asp-for="Address"></label><input asp-for="Address" /></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="What does your business offer?"></textarea></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span></div></div><button class="platform-btn platform-btn-primary" type="submit">Submit registration →</button></form></div></div></section>
